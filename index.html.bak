// Build guidance steps
var gsSteps=[
  {n:'01',t:'In the first hours and days',b:'You may feel shock, numbness, or an inability to make decisions. This is completely normal. Ask the hospital for a bereavement midwife or coordinator &mdash; most hospitals have one. You have the right to hold your baby, take photos, and take as much time as you need. Memory boxes are often available and can become deeply precious.'},
  {n:'02',t:'Practical decisions you may need to make',b:'Registration of birth and death, decisions about a post-mortem (you can say no), funeral arrangements, and notifying your employer. You do not need to make these alone or immediately. A bereavement coordinator can guide you step by step.'},
  {n:'03',t:'Returning home',b:'Returning to a home prepared for a baby is one of the most painful moments many parents describe. Ask a trusted person to help with the room if you need to, or leave it exactly as it is. There is no right answer and no timeline you must follow.'},
  {n:'04',t:'Telling people',b:'You are under no obligation to share anything before you are ready. Many parents find a short pre-written message most manageable: <em>&ldquo;Our baby was born sleeping. We are devastated and need time. We will reach out when we are ready.&rdquo;</em>'},
  {n:'05',t:'Grief over time',b:'Grief does not follow a neat path. Waves of intense pain can appear months or years later &mdash; around due dates, anniversaries, or when seeing other babies. This is not going backwards. Specialist counsellors who understand pregnancy loss can make an enormous difference.'},
  {n:'06',t:'Thinking of a future pregnancy',b:'Many parents feel profound conflict about trying again &mdash; hope, fear, guilt, and love all at once. Rainbow baby pregnancies are often filled with anxiety. Ask for a referral to a specialist antenatal clinic for bereaved parents.'},
  {n:'07',t:'Supporting a partner',b:'Grief rarely runs at the same pace between partners. One person may want to talk; the other may need silence. Both are valid. Couples counselling from a pregnancy-loss specialist can help you grieve together rather than in parallel and alone.'}
];
var gsSL=document.getElementById('gs-step-list');
gsSteps.forEach(function(s){
  var d=document.createElement('div');d.className='gs-step';
  d.innerHTML='<div class="gs-step-left"><span class="gs-step-label">Step</span><span class="gs-step-n">'+s.n+'</span></div><div><h3 class="gs-step-title">'+s.t+'</h3><p class="gs-step-body">'+s.b+'</p></div>';
  gsSL.appendChild(d);
});

