  <!-- Label -->
  <text x="410" y="300" text-anchor="middle" font-family="Montserrat,sans-serif" font-size="10" fill="#5C5C58" letter-spacing="2">A GRIEF OBSERVED &nbsp;&middot;&nbsp; C.S. LEWIS &nbsp;&middot;&nbsp; 1961</text>
