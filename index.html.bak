  <rect width="820" height="320" fill="#F1EFE8"/>
  <!-- Main box open -->
  <rect x="280" y="160" width="260" height="120" rx="4" fill="#fff" stroke="#E0DDD5" stroke-width="1.5"/>
  <!-- Box lid open -->
  <path d="M280 160 Q410 100 540 160" fill="none" stroke="#E0DDD5" stroke-width="1.5"/>
  <path d="M280 160 Q410 110 540 160" fill="#fff" stroke="#E0DDD5" stroke-width="1"/>
