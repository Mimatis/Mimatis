<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MIMATIS — Free Baby Loss Support in 29 Countries | Stillbirth, Miscarriage &amp; Neonatal Loss</title>
<meta name="google-site-verification" content="IT4inXCtbUE3RZI77cct8iXJWi9rJkUF-oDNJqyfCjc" />
<meta name="description" content="MIMATIS is a free support platform for parents after miscarriage, stillbirth or neonatal loss. Verified resources in 29 countries, peer-reviewed research, memorial garden and compassionate guidance. Always free.">
<meta name="keywords" content="stillbirth support, miscarriage support, neonatal loss, baby loss, perinatal grief, pregnancy loss, bereaved parents, infant loss, baby bereavement, stillbirth resources, miscarriage resources, neonatal death support">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://www.mimatis.org/">
<link rel="alternate" hreflang="en" href="https://www.mimatis.org/">
<link rel="alternate" hreflang="x-default" href="https://www.mimatis.org/">
<meta property="og:title" content="MIMATIS — Free Baby Loss Support in 29 Countries">
<meta property="og:description" content="A free, resource for parents who have experienced miscarriage, stillbirth, or neonatal loss.">
<meta property="og:url" content="https://www.mimatis.org/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Cormorant:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  /* MIMATIS brand greens */
  --green:#0097B2;
  --green-dark:#00708A;
  --green-light:#E0F4F8;
  /* warm blush — Pink Elephants inspired secondary */
  --blush:#E2A9F1;
  --blush-light:#F6EAFB;
  --blush-dark:#B06FD0;
  /* sage — for gentle section backgrounds */
  --sage:#E3F5F8;
  --sage-mid:#BFE6EE;
  /* page & surface */
  --off:#FFFFFF;
  --white:#ffffff;
  --cream:#FFFFFF;
  /* text */
  --ink:#1E1E1E;
  --mid:#2B2B29;
  --soft:#5C5C58;
  --border:#E8E4DF;
  /* legacy aliases */
  --rose:#0097B2;
  --rd:#00708A;
  --rp:#E0F4F8;
  --bdr:rgba(30,30,30,0.08);
  --ghost:#C8C2BB;
}
html{scroll-behavior:smooth}
body{font-family:'Montserrat',sans-serif;background:var(--off);color:var(--ink);font-weight:400;overflow-x:hidden;line-height:1.95;font-size:18px;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:var(--off)}::-webkit-scrollbar-thumb{background:var(--green-light);border-radius:2px}

/* NAV */
#nav{position:fixed;top:0;left:0;right:0;z-index:300;height:64px;background:rgba(255,255,255,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;padding:0 3rem}
.logo{font-family:'Inter',sans-serif;font-size:1.1rem;font-weight:400;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;color:var(--green-dark);text-decoration:none;background:none;border:none}

.nav-links{display:flex;gap:1.75rem;align-items:center}
.nav-links button{font-size:.63rem;letter-spacing:.15em;text-transform:uppercase;color:var(--mid);text-decoration:none;transition:color .2s;white-space:nowrap;background:none;border:none;cursor:pointer;font-family:'Montserrat',sans-serif;font-weight:400;padding:0}
.nav-links button:hover{color:var(--green-dark)}
.nav-links button.active{color:var(--ink);border-bottom:2px solid var(--green);padding-bottom:2px}
.hbg{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px}
.hbg span{display:block;width:22px;height:1.5px;background:var(--green-dark);transition:all .3s}
.hbg.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.hbg.open span:nth-child(2){opacity:0}
.hbg.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
.mob{display:none;position:fixed;inset:64px 0 0;background:var(--white);z-index:200;flex-direction:column;align-items:center;justify-content:center;gap:1.75rem;padding:2rem;overflow-y:auto}
.mob.open{display:flex}
.mob button{font-family:'Inter',sans-serif;font-size:1.5rem;font-style:italic;color:var(--green-dark);background:none;border:none;cursor:pointer;transition:color .2s}
.mob button:hover{color:var(--green)}

/* PAGES */
.pg{display:none;min-height:100vh;padding-top:68px;animation:fadeIn .3s ease}
.pg.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* HOME page specific */
#pg-home{background:var(--off)}
.home-hero{min-height:calc(100vh - 64px);display:flex;flex-direction:column;justify-content:center;padding:4rem 3rem 3rem;max-width:860px;margin:0 auto}
.hero-title{font-family:'Inter',sans-serif;font-size:clamp(2.6rem,5.5vw,4.8rem);font-weight:400;line-height:1.08;color:var(--ink);margin-bottom:2rem}
.hero-title em{font-style:italic;color:var(--green-dark)}
.hero-sub{font-size:1rem;color:var(--mid);max-width:560px;line-height:1.95;margin-bottom:3.5rem;font-weight:400}
.hero-btns{display:flex;flex-wrap:wrap;gap:.85rem;margin-bottom:4.5rem}
.btn-ink{background:var(--green);color:#fff;border:none;padding:.85rem 1.85rem;font-family:'Montserrat',sans-serif;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s;font-weight:400}
.btn-ink:hover{background:var(--green-dark)}
.btn-bdr{background:transparent;color:var(--green-dark);border:1px solid var(--green-dark);padding:.85rem 1.85rem;font-family:'Montserrat',sans-serif;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:all .2s;font-weight:400}
.btn-bdr:hover{background:var(--green-dark);color:#fff}
.btn-rose{background:var(--green);color:#fff;border:none;padding:.85rem 1.85rem;font-family:'Montserrat',sans-serif;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s;font-weight:400}
.btn-rose:hover{background:var(--green-dark)}
.btn-red{background:var(--green-light);color:var(--green-dark);border:none;padding:.85rem 1.85rem;font-family:'Montserrat',sans-serif;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s;font-weight:400}
.btn-red:hover{background:var(--green);color:#fff;}




/* HOME country section */
.home-country{padding:5rem 3rem;max-width:1000px;margin:0 auto;border-top:1px solid var(--bdr)}
.sec-eye{font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:var(--green);margin-bottom:1.25rem;display:block}
.sec-title{font-family:'Inter',sans-serif;font-size:clamp(1.8rem,3vw,2.8rem);font-weight:400;line-height:1.15;color:var(--ink);margin-bottom:1rem}
.sec-title em{font-style:italic;color:var(--green-dark)}
.sec-body{font-size:.9rem;color:var(--mid);line-height:1.85;max-width:560px;margin-bottom:2.5rem}
.crisis{background:#F8F0FC;border:1px solid rgba(201,169,155,.3);padding:1.1rem 1.75rem;display:flex;gap:.75rem;align-items:center;margin-bottom:2.5rem;border-radius:2px}
.crisis p{font-size:.82rem;color:var(--mid);flex:1;line-height:1.6}
.crisis strong{color:var(--green-dark)}

/* INFO CARDS strip on home */
.info-strip{background:var(--green-dark);padding:2.5rem 3rem;margin-top:0}
.info-strip-inner{max-width:1000px;margin:0 auto;display:flex;gap:2rem;align-items:center;flex-wrap:wrap}
.info-strip h3{font-family:'Inter',sans-serif;font-size:1.1rem;font-weight:400;color:#fff;flex:1;min-width:200px;line-height:1.3}
.info-strip h3 em{font-style:italic;color:var(--green)}
.info-strip p{font-size:.8rem;color:rgba(255,255,255,.5);flex:2;line-height:1.7;min-width:260px}
.info-strip-btns{display:flex;gap:.75rem;flex-wrap:wrap;flex-shrink:0}
.btn-rose-outline{background:transparent;color:var(--green);border:1px solid var(--green);padding:.7rem 1.4rem;font-family:'Montserrat',sans-serif;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;transition:all .2s;font-weight:400;text-decoration:none;display:inline-block}
.btn-rose-outline:hover{background:var(--green-light);color:#fff}

/* COUNTRY GRID */
.cg{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));border:1px solid var(--bdr);margin-bottom:2.5rem}
.cb{padding:.8rem .65rem;border:none;border-right:1px solid var(--bdr);border-bottom:1px solid var(--bdr);background:var(--white);font-family:'Montserrat',sans-serif;font-size:.7rem;color:var(--mid);cursor:pointer;transition:all .2s;text-align:left;line-height:1.3}
.cb:hover{background:var(--green-light);color:var(--green-dark)}
.cb.active{background:var(--green-dark);color:#fff}
.cr{display:none;margin-top:2rem}.cr.show{display:block}
.cr-title{font-family:'Inter',sans-serif;font-size:1.5rem;font-weight:400;font-style:italic;color:var(--ink);margin-bottom:.3rem}
.cr-sub{font-size:.75rem;color:var(--soft);margin-bottom:1.75rem;font-style:italic}
.rg{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:1px;background:var(--bdr);border:1px solid var(--bdr);margin-bottom:.75rem}
.rc{background:var(--white);padding:1.5rem;transition:background .2s}
.rc:hover{background:var(--off)}
.rtag{font-size:.56rem;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:.5rem}
.rtag.ft{color:#8a6040}
.rname{font-family:'Inter',sans-serif;font-size:.95rem;font-weight:400;color:var(--ink);margin-bottom:.4rem;line-height:1.3}
.rdesc{font-size:.77rem;color:var(--mid);line-height:1.65;margin-bottom:.65rem}
.lt-custom{max-width:860px}
.lt-h{font-family:'Inter',sans-serif;font-size:1.18rem;font-weight:400;color:var(--ink);line-height:1.32;margin:2.4rem 0 .85rem}
.lt-custom > .lt-h:first-child{margin-top:.25rem}
.lt-custom p{font-size:.92rem;color:var(--mid);line-height:1.85;margin-bottom:.95rem;font-weight:400}
.lt-custom strong{color:var(--ink);font-weight:500}
.lt-lead{display:block;color:var(--ink);font-weight:500;font-size:.92rem;margin:1.2rem 0 .5rem}
.lt-custom ul{list-style:none;margin:.1rem 0 1.1rem;padding:0}
.lt-custom li{position:relative;padding-left:1.25rem;margin-bottom:.5rem;font-size:.92rem;color:var(--mid);line-height:1.7;font-weight:400}
.lt-custom li::before{content:"";position:absolute;left:.1rem;top:.62em;width:5px;height:5px;background:var(--green);border-radius:50%}
.lt-table-title{font-family:'Inter',sans-serif;font-size:1.18rem;font-weight:400;color:var(--ink);margin:2.6rem 0 1rem}
.lt-table-wrap{overflow-x:auto;margin-bottom:.5rem}
.lt-table{width:100%;border-collapse:collapse;font-size:.82rem;min-width:520px}
.lt-table th{font-family:'Montserrat',sans-serif;font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--green);text-align:left;padding:.7rem .9rem;border-bottom:2px solid var(--green);font-weight:600;white-space:nowrap}
.lt-table td{padding:.8rem .9rem;border-bottom:1px solid var(--border);color:var(--mid);line-height:1.5;vertical-align:top}
.lt-table td:first-child{color:var(--ink);font-weight:500}
.lt-table a{color:var(--green);text-decoration:none;word-break:break-word}
.lt-table a:hover{text-decoration:underline}
.lt-table tbody tr:hover td{background:var(--green-light)}
.rc a{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green-dark);text-decoration:none}
.rc a:hover{color:var(--green-dark)}.rc a::after{content:' →'}
.fsec-title{font-size:.67rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6040;margin:2rem 0 1rem;padding-top:1.25rem;border-top:1px solid var(--bdr)}

/* INNER PAGE WRAPPER */
.pg-inner{max-width:960px;margin:0 auto;padding:5rem 3rem}
.pg-inner-narrow{max-width:780px;margin:0 auto;padding:5rem 3rem}

/* GARDEN */
.gsky{background:linear-gradient(180deg,#d8ede6 0%,#c8e6d8 35%,#a8d4bc 70%,#85b89a 100%);border:1px solid var(--bdr);position:relative;height:380px;overflow:hidden;margin:2rem 0}
.gnd{position:absolute;bottom:0;left:0;right:0;height:68px;background:#587a51}
.gnd2{position:absolute;bottom:61px;left:0;right:0;height:14px;background:#6a9060;border-radius:40% 40% 0 0}
.gstar{position:absolute;border-radius:50%;background:rgba(255,255,255,.8);animation:tw var(--d,3s) infinite alternate}
@keyframes tw{from{opacity:.2;transform:scale(.7)}to{opacity:1;transform:scale(1.3)}}
.flower{position:absolute;bottom:50px;cursor:pointer;text-align:center;animation:bloom .6s cubic-bezier(.34,1.56,.64,1);transform:translateX(-50%)}
@keyframes bloom{from{transform:translateX(-50%) scale(0) translateY(20px);opacity:0}to{transform:translateX(-50%) scale(1) translateY(0);opacity:1}}
.fh{font-size:1.7rem;line-height:1;display:block}
.fstem{width:2px;background:#3c6934;margin:0 auto;border-radius:1px}
.fn{font-size:.56rem;color:var(--ink);background:rgba(255,255,255,.9);padding:1px 5px;margin-top:2px;white-space:nowrap;max-width:65px;overflow:hidden;text-overflow:ellipsis}
.ftip{position:absolute;bottom:110%;left:50%;transform:translateX(-50%);background:var(--green-dark);color:#fff;font-size:.63rem;padding:4px 8px;white-space:nowrap;opacity:0;transition:opacity .2s;pointer-events:none}
.flower:hover .ftip{opacity:1}
.fc{text-align:center;font-size:.78rem;color:var(--soft);font-style:italic;margin-bottom:1rem}
.pfa{display:grid;grid-template-columns:1fr 1fr 130px auto;border:1px solid var(--bdr);margin-top:1.75rem}
.pf{display:flex;flex-direction:column;border-right:1px solid var(--bdr)}
.pf label{font-size:.57rem;letter-spacing:.18em;text-transform:uppercase;color:var(--green);padding:.75rem 1rem .22rem;border-bottom:1px solid var(--bdr)}
.pf input,.pf select{border:none;background:transparent;padding:.55rem 1rem .75rem;font-family:'Montserrat',sans-serif;font-size:.9rem;color:var(--ink);outline:none}
.pf-btn{background:var(--green-dark);color:#fff;border:none;cursor:pointer;font-family:'Montserrat',sans-serif;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;transition:background .2s;padding:0 1.4rem}
.pf-btn:hover{background:var(--green-dark)}

/* RESEARCH */
.frow{display:flex;border:1px solid var(--bdr);margin-bottom:2.5rem;overflow-x:auto}
.fbtn{padding:.75rem 1.4rem;border:none;border-right:1px solid var(--bdr);background:var(--white);font-family:'Montserrat',sans-serif;font-size:.67rem;letter-spacing:.13em;text-transform:uppercase;color:var(--mid);cursor:pointer;transition:all .2s;white-space:nowrap}
.fbtn:last-child{border-right:none}
.fbtn:hover{background:var(--green-light);color:var(--green-dark)}
.fbtn.active{background:var(--green-dark);color:#fff}
.slist{border:1px solid var(--bdr)}
.si{padding:1.75rem 2.25rem;border-bottom:1px solid var(--bdr);display:grid;grid-template-columns:85px 1fr;gap:1.75rem;align-items:start;transition:background .2s}
.si:last-child{border-bottom:none}
.si:hover{background:var(--off)}
.sm{text-align:right}
.sy{font-family:'Inter',sans-serif;font-size:1.4rem;color:var(--ghost);line-height:1;margin-bottom:.35rem}
.stag{display:inline-block;font-size:.54rem;letter-spacing:.15em;text-transform:uppercase;padding:2px 6px}
.tag-sb{background:var(--green-light);color:var(--green-dark)}
.tag-nn{background:rgba(143,168,152,.15);color:#4a7060}
.tag-gr{background:rgba(184,151,90,.12);color:#7a6030}
.tag-pr{background:rgba(100,120,180,.12);color:#3a4878}
.tag-mc{background:var(--green-light);color:var(--green-dark)}
.stitle{font-family:'Inter',sans-serif;font-size:1rem;font-weight:400;color:var(--ink);margin-bottom:.45rem;line-height:1.4}
.sabst{font-size:.8rem;color:var(--mid);line-height:1.75;margin-bottom:.45rem}
.sjou{font-size:.7rem;color:var(--soft);font-style:italic}
.slink{display:inline-block;margin-top:.55rem;font-size:.63rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green-dark);text-decoration:none;border-bottom:1px solid rgba(160,112,96,.3);padding-bottom:1px}
.slink:hover{color:var(--ink)}

/* GUIDANCE */
.gtl{position:relative;padding-left:2.75rem}
.gl{position:absolute;left:0;top:0;bottom:0;width:1px;background:linear-gradient(180deg,var(--green) 0%,var(--border) 100%)}
.gs{margin-bottom:3.5rem;position:relative}
.gdot{position:absolute;left:-3.25rem;top:5px;width:11px;height:11px;border-radius:50%;background:#fff;border:2px solid var(--green)}
.gnum{font-size:.59rem;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:.5rem}
.gtitle{font-family:'Inter',sans-serif;font-size:1.3rem;font-weight:400;color:var(--ink);margin-bottom:.75rem;line-height:1.3}
.gbody{font-size:.9rem;color:var(--mid);line-height:1.9;max-width:620px}
.gbody em{font-style:italic;color:var(--ink)}

/* LETTER */
.lc{border:1px solid var(--bdr);overflow:hidden}
.ltool{background:var(--off);border-bottom:1px solid var(--bdr);padding:1rem 1.6rem;display:flex;gap:.7rem;flex-wrap:wrap;align-items:center}
.tlbl{font-size:.63rem;letter-spacing:.15em;text-transform:uppercase;color:var(--soft);margin-right:.2rem}
.tbtn{padding:.4rem .95rem;border:1px solid var(--bdr);background:#fff;font-family:'Montserrat',sans-serif;font-size:.67rem;letter-spacing:.1em;color:var(--mid);cursor:pointer;transition:all .2s}
.tbtn:hover,.tbtn.active{background:var(--green-dark);color:#fff;border-color:var(--ink)}
.linputs{display:grid;grid-template-columns:1fr 1fr}
.lf{display:flex;flex-direction:column;border-right:1px solid var(--bdr);border-bottom:1px solid var(--bdr)}
.lf:nth-child(2n){border-right:none}.lf.full{grid-column:1/-1;border-right:none}
.lf label{font-size:.57rem;letter-spacing:.2em;text-transform:uppercase;color:var(--green);padding:.75rem 1.2rem .22rem;border-bottom:1px solid var(--bdr)}
.lf select,.lf input{border:none;background:transparent;padding:.6rem 1.2rem .75rem;font-family:'Montserrat',sans-serif;font-size:.9rem;color:var(--ink);outline:none}
.lgen{background:var(--off);border-top:1px solid var(--bdr);padding:1.1rem 1.6rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
.lgen p{font-size:.78rem;color:var(--soft);max-width:380px;line-height:1.6}
.lout{margin-top:2.25rem;display:none;border:1px solid var(--bdr)}
.lout.show{display:block}
.loh{background:var(--off);border-bottom:1px solid var(--bdr);padding:.9rem 1.6rem;display:flex;justify-content:space-between;align-items:center}
.loh span{font-size:.63rem;letter-spacing:.2em;text-transform:uppercase;color:var(--soft)}
.lob{padding:2.5rem;font-family:'Cormorant',serif;font-size:1.08rem;font-weight:400;line-height:2.1;color:var(--mid);white-space:pre-wrap;min-height:200px}
.lol{padding:.9rem 1.6rem;border-top:1px solid var(--bdr);display:flex;gap:.75rem;flex-wrap:wrap}
.bsm{padding:.45rem 1.15rem;font-family:'Montserrat',sans-serif;font-size:.63rem;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;transition:all .2s;border:1px solid}
.bsm-o{background:transparent;border-color:var(--bdr);color:var(--mid)}.bsm-o:hover{border-color:var(--ink);color:var(--ink)}
.bsm-s{background:var(--green-dark);border-color:var(--ink);color:#fff}.bsm-s:hover{background:var(--mid)}

/* BOOKS & RESOURCES */
.resources-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1px;background:var(--bdr);border:1px solid var(--bdr);margin-bottom:2.5rem}
.res-card{background:var(--white);padding:1.85rem;transition:background .2s;display:flex;flex-direction:column;gap:1rem}
.res-card:hover{background:var(--off)}
.res-type{font-size:.57rem;letter-spacing:.2em;text-transform:uppercase;color:var(--green)}
.res-title{font-family:'Inter',sans-serif;font-size:1.05rem;font-weight:400;color:var(--ink);line-height:1.3}
.res-author{font-size:.76rem;color:var(--soft);font-style:italic}
.res-desc{font-size:.8rem;color:var(--mid);line-height:1.75;flex:1}
.res-link{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green-dark);text-decoration:none;border-bottom:1px solid rgba(160,112,96,.3);padding-bottom:1px;align-self:flex-start}
.res-link:hover{color:var(--ink)}
.artist-card{border:1px solid var(--bdr);padding:2.5rem;margin-top:2.5rem;display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:center;background:var(--green-light)}
.artist-eye{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);margin-bottom:.9rem}
.artist-title{font-family:'Inter',sans-serif;font-size:1.4rem;font-weight:400;color:var(--ink);margin-bottom:.7rem;line-height:1.2}
.artist-title em{font-style:italic}
.artist-desc{font-size:.85rem;color:var(--mid);line-height:1.8;max-width:440px}

/* INFO CARDS PAGE */
.nova-card{border:1px solid rgba(201,169,155,.3);background:var(--white);padding:2rem;margin-bottom:1.25rem;transition:background .2s}
.nova-card:hover{background:var(--off)}
.nova-card-title{font-family:'Inter',sans-serif;font-size:1rem;color:var(--ink);margin-bottom:.4rem}
.nova-card-desc{font-size:.8rem;color:var(--mid);line-height:1.7;margin-bottom:.7rem}
.nova-card a{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green-dark);text-decoration:none}
.nova-card a:hover{color:var(--ink)}.nova-card a::after{content:' →'}
.lang-grid{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.25rem}
.lang-tag{background:var(--green-light);border:1px solid rgba(201,169,155,.3);padding:.3rem .75rem;font-size:.68rem;color:var(--mid);border-radius:1px}

/* FOOTER */
footer{background:var(--green-dark);padding:3rem 3rem}
.foot-inner{max-width:960px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem}
.foot-logo{font-family:'Inter',sans-serif;font-size:1rem;font-weight:400;letter-spacing:.22em;text-transform:uppercase;color:#fff}

.foot-links{display:flex;gap:1.4rem;flex-wrap:wrap;align-items:center}
.foot-link{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.6);text-decoration:none;transition:color .2s;background:none;border:none;cursor:pointer;font-family:'Montserrat',sans-serif}
.foot-link:hover{color:#fff}
.foot-copy{font-size:.65rem;color:rgba(255,255,255,.2);width:100%;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.07)}

/* RESPONSIVE */
@media(max-width:900px){
  .si{grid-template-columns:1fr;gap:.4rem}.sm{text-align:left;display:flex;gap:.65rem;align-items:center}
  .pfa{grid-template-columns:1fr 1fr}.pf-btn{padding:.9rem;grid-column:1/-1;border-top:1px solid var(--bdr)}
  .linputs{grid-template-columns:1fr}.lf:nth-child(2n){border-right:none}
  .artist-card{grid-template-columns:1fr}
  .home-country{padding:4rem 2rem}
  .pg-inner,.pg-inner-narrow{padding:4rem 2rem}
  .info-strip{padding:2.25rem 2rem}
}
@media(max-width:640px){
  #nav{padding:0 1.25rem}.nav-links{display:none}.hbg{display:flex}
  .home-hero{padding:5.5rem 1.25rem 3rem;min-height:auto}
  .hero-title{font-size:2.4rem}
  .hero-btns{gap:.55rem}
  .btn-ink,.btn-bdr,.btn-rose,.btn-red{padding:.75rem 1.3rem;font-size:.65rem}
  
  .cg{grid-template-columns:repeat(2,1fr)}
  .rg,.resources-grid{grid-template-columns:1fr}
  .pfa{grid-template-columns:1fr}.pf{border-right:none}
  .home-country{padding:3rem 1.25rem}
  .pg-inner,.pg-inner-narrow{padding:3rem 1.25rem}
  .info-strip{padding:2rem 1.25rem}
  .foot-inner{flex-direction:column;align-items:flex-start}
  footer{padding:2rem 1.25rem}
}

.acc-item{border:0.5px solid var(--bdr);border-radius:10px;overflow:hidden;transition:border-color .2s}
.acc-item:hover{border-color:rgba(29,158,117,.5)}
.acc-item.open{border-color:var(--green)}
.acc-header{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.5rem;cursor:pointer;background:var(--white);user-select:none;gap:1rem}
.acc-item.open .acc-header,.acc-header:hover{background:var(--off)}
.acc-left{display:flex;align-items:center;gap:1rem}
.acc-num{font-size:.6rem;letter-spacing:.12em;color:var(--green);min-width:22px;font-weight:400}
.acc-situation{font-size:.6rem;text-transform:uppercase;letter-spacing:.14em;color:var(--soft);margin-bottom:3px}
.acc-name{font-family:'Inter',sans-serif;font-size:.95rem;font-weight:400;color:var(--ink)}
.acc-name em{font-style:italic;color:var(--green-dark)}
.acc-chevron{color:var(--soft);transition:transform .25s;font-size:.8rem;flex-shrink:0}
.acc-item.open .acc-chevron{transform:rotate(180deg)}
.acc-body{display:none;border-top:0.5px solid var(--bdr)}
.acc-item.open .acc-body{display:block}
.acc-letter{font-family:'Cormorant',serif;font-size:1.05rem;font-weight:400;line-height:2.1;color:var(--mid);padding:2rem 2.25rem;white-space:pre-wrap;background:var(--white)}
.acc-footer{border-top:0.5px solid var(--bdr);padding:.85rem 1.5rem;display:flex;justify-content:space-between;align-items:center;background:var(--off);gap:1rem;flex-wrap:wrap}
.acc-note{font-size:.72rem;color:var(--soft);line-height:1.6;max-width:420px;font-style:italic}
.acc-copy{display:flex;align-items:center;gap:5px;background:var(--white);border:0.5px solid var(--bdr);border-radius:6px;padding:.4rem .9rem;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mid);cursor:pointer;font-family:'Montserrat',sans-serif;transition:all .2s;white-space:nowrap;flex-shrink:0}
.acc-copy:hover{border-color:var(--ink);color:var(--ink)}
.acc-copy.done{color:var(--sage);border-color:var(--sage)}

.wcard{border:0.5px solid var(--bdr);border-radius:8px;overflow:hidden;transition:border-color .2s}
.wcard:hover{border-color:rgba(29,158,117,.5)}
.wcard.open{border-color:var(--green)}
.wcard-header{padding:1rem 1.25rem;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;cursor:pointer;user-select:none;background:var(--white)}
.wcard-header:hover,.wcard.open .wcard-header{background:var(--off)}
.wcard-quote{font-family:'Inter',sans-serif;font-size:.92rem;font-style:italic;color:var(--ink);line-height:1.4;flex:1}
.wcard-quote.nq{color:#72243E}.wcard-quote.yq{color:#00708A}
.wcard-chev{color:var(--soft);transition:transform .25s;flex-shrink:0;font-size:14px;margin-top:3px}
.wcard.open .wcard-chev{transform:rotate(180deg)}
.wcard-body{display:none;border-top:0.5px solid var(--bdr);padding:1.1rem 1.25rem}
.wcard.open .wcard-body{display:block}
.wcard-why{font-size:.8rem;color:var(--mid);line-height:1.8;margin-bottom:.85rem}
.wcard-inlabel{font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;color:var(--soft);margin-bottom:.4rem;display:block}
.wcard-alt{font-family:'Inter',sans-serif;font-size:.88rem;font-style:italic;color:var(--ink);line-height:1.6;padding:.65rem 1rem;background:var(--off);border-left:2px solid var(--green)}



/* GUIDANCE & SUPPORT COMBINED PAGE */
.gs-landing-top{padding:3.5rem 3rem 0}
.gs-eye{font-size:.6rem;letter-spacing:.28em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:1.1rem}
.gs-main-title{font-family:'Inter',sans-serif;font-size:clamp(2rem,4vw,2.8rem);font-weight:400;line-height:1.08;color:var(--ink);margin-bottom:1rem}
.gs-main-title em{font-style:italic;color:var(--green-dark)}
.gs-main-sub{font-size:.88rem;color:var(--mid);line-height:1.85;max-width:500px;font-weight:400;margin-bottom:2.5rem}
.gs-rule{height:0.5px;background:var(--green-light);margin:0 3rem}
.gs-cards-grid{display:grid;grid-template-columns:1fr 1fr;gap:0}
.gs-first{padding:2.75rem 1.5rem 1.25rem;max-width:820px;margin:0 auto}
.gs-first-h{font-family:'Inter',sans-serif;font-size:1.2rem;font-weight:400;color:var(--ink);line-height:1.32;margin:2.6rem 0 .9rem}
.gs-first-h:first-child{margin-top:0}
.gs-first p{font-size:1.02rem;color:var(--mid);line-height:1.95;margin-bottom:1.05rem;font-weight:400}
.gs-first strong{color:var(--ink);font-weight:500}
.gs-first em{font-style:italic;color:var(--ink)}
.gs-first-lead{display:block;color:var(--ink);font-weight:500;font-size:1.02rem;margin:1.5rem 0 .55rem}
.gs-first ul{list-style:none;margin:.15rem 0 1.3rem;padding:0}
.gs-first p+ul{margin-top:-.45rem}
.gs-first li{position:relative;padding-left:1.3rem;margin-bottom:.55rem;font-size:1.02rem;color:var(--mid);line-height:1.8;font-weight:400}
.gs-first li::before{content:"";position:absolute;left:.15rem;top:.72em;width:5px;height:5px;background:var(--green);border-radius:50%}
.gs-next{padding:2.25rem 3rem .25rem}
.gs-next .gs-eye{margin-bottom:.55rem}
.gs-next p{font-size:.88rem;color:var(--mid);line-height:1.8;max-width:520px;font-weight:400;margin:0}
.gs-card{padding:2.25rem 3rem;border-right:0.5px solid var(--bdr);border-bottom:0.5px solid var(--bdr);cursor:pointer;transition:background .2s;position:relative;overflow:hidden;background:none;border-top:none;font-family:'Montserrat',sans-serif;text-align:left;width:100%}
.gs-card:nth-child(2n){border-right:none}
.gs-card:nth-child(5),.gs-card:nth-child(6){border-bottom:none}
.gs-card:hover{background:var(--off)}
.gs-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--green-light);transform:scaleY(0);transform-origin:top;transition:transform .3s}
.gs-card:hover::before{transform:scaleY(1)}
.gs-card-num{font-family:'Inter',sans-serif;font-size:48px;font-weight:400;color:var(--ghost);line-height:1;margin-bottom:.85rem;display:block;opacity:.4}
.gs-card-eye{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);margin-bottom:.5rem;display:block}
.gs-card-title{font-family:'Inter',sans-serif;font-size:1.15rem;font-weight:400;color:var(--ink);margin-bottom:.55rem;line-height:1.2}
.gs-card-title em{font-style:italic;color:var(--green-dark)}
.gs-card-desc{font-size:.77rem;color:var(--soft);line-height:1.7;margin-bottom:1.1rem;font-weight:400;max-width:280px}
.gs-card-arrow{display:inline-flex;align-items:center;gap:.35rem;font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink);font-weight:400}
.gs-card-arrow::after{content:'\2192';font-size:14px}

/* INNER SUBPAGES */
.gs-inner-nav{display:flex;align-items:center;gap:.85rem;padding:1.25rem 3rem;border-bottom:0.5px solid var(--bdr)}
.gs-back{display:flex;align-items:center;gap:.35rem;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--soft);cursor:pointer;background:none;border:none;font-family:'Montserrat',sans-serif;font-weight:400;transition:color .2s;padding:0}
.gs-back:hover{color:var(--ink)}
.gs-back::before{content:'\2190';font-size:13px}
.gs-bc-sep{color:var(--ghost);font-size:.7rem}
.gs-bc-cur{font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--green)}
.gs-inner-body{padding:3rem}
.gs-sub-view{display:none}.gs-sub-view.active{display:block}

/* STEPS */
.gs-step-list{display:flex;flex-direction:column}
.gs-step{display:grid;grid-template-columns:56px 1fr;gap:1.75rem;padding:2rem 0;border-bottom:0.5px solid var(--bdr)}
.gs-step:last-child{border-bottom:none}
.gs-step-left{text-align:right;padding-top:3px}
.gs-step-label{font-family:'Inter',sans-serif;font-size:.65rem;color:var(--ghost);display:block;margin-bottom:.2rem;font-style:italic}
.gs-step-n{font-family:'Inter',sans-serif;font-size:2rem;font-weight:400;color:var(--ghost);line-height:1;opacity:.5}
.gs-step-title{font-family:'Inter',sans-serif;font-size:1.15rem;font-weight:400;color:var(--ink);margin-bottom:.65rem;line-height:1.3}
.gs-step-body{font-size:1.05rem;color:var(--mid);line-height:2}
.gs-step-body em{font-style:italic;color:var(--ink)}

/* LETTER ACCORDION */
.gs-acc{border-bottom:0.5px solid var(--bdr)}
.gs-acc:first-child{border-top:0.5px solid var(--bdr)}
.gs-acc-header{display:flex;align-items:flex-start;justify-content:space-between;padding:1.1rem 0;cursor:pointer;gap:1rem;background:none;border:none;width:100%;text-align:left;font-family:'Montserrat',sans-serif}
.gs-acc-header:hover .gs-acc-title{color:var(--green-dark)}
.gs-acc-left{display:flex;align-items:flex-start;gap:.85rem}
.gs-acc-num{font-family:'Inter',sans-serif;font-size:.75rem;color:var(--ghost);min-width:22px;padding-top:3px}
.gs-acc-sit{font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--soft);margin-bottom:3px;display:block}
.gs-acc-title{font-family:'Inter',sans-serif;font-size:.95rem;font-style:italic;color:var(--ink);transition:color .2s;line-height:1.3}
.gs-acc-chev{font-size:.7rem;color:var(--ghost);transition:transform .25s;flex-shrink:0;margin-top:5px}
.gs-acc.open .gs-acc-chev{transform:rotate(180deg)}
.gs-acc-body{display:none;padding-bottom:1.75rem;padding-left:2.6rem}
.gs-acc.open .gs-acc-body{display:block}
.gs-acc-text{font-family:'Cormorant',serif;font-size:1.05rem;font-weight:400;line-height:2.1;color:var(--mid);white-space:pre-wrap;margin-bottom:.85rem}
.gs-acc-note-lbl{font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);display:block;margin-bottom:.35rem}
.gs-acc-note{font-size:.8rem;color:var(--ink);padding:.55rem 1rem;background:var(--off);border-left:2px solid var(--green);font-style:italic;font-family:'Inter',sans-serif;line-height:1.5;margin-bottom:.75rem}
.gs-copy-btn{background:transparent;border:0.5px solid var(--bdr);padding:.32rem .85rem;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);cursor:pointer;font-family:'Montserrat',sans-serif;transition:all .2s}
.gs-copy-btn:hover{border-color:var(--green);color:var(--green)}

/* WHAT TO SAY */
.gs-say-lbl{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;margin-bottom:.85rem;display:flex;align-items:center;gap:.55rem}
.gs-say-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
.gs-say-sec-title{font-family:'Inter',sans-serif;font-size:1.1rem;font-weight:400;color:var(--ink);margin-bottom:1.25rem;padding-bottom:.85rem;border-bottom:0.5px solid var(--bdr)}
.gs-say-cards{display:flex;flex-direction:column;gap:.4rem;margin-bottom:2.25rem}
.gs-say-card{border:0.5px solid var(--bdr);overflow:hidden;transition:border-color .2s}
.gs-say-card.open{border-color:rgba(29,158,117,.5)}
.gs-say-hdr{display:flex;align-items:flex-start;justify-content:space-between;padding:.85rem 1.1rem;cursor:pointer;gap:.75rem;background:none;border:none;width:100%;text-align:left;font-family:'Montserrat',sans-serif}
.gs-say-hdr:hover,.gs-say-card.open .gs-say-hdr{background:var(--off)}
.gs-say-q{font-family:'Inter',sans-serif;font-size:.88rem;font-style:italic;line-height:1.4;flex:1}
.gs-say-q.nq{color:#72243E}.gs-say-q.yq{color:#00708A}
.gs-say-chev{font-size:.65rem;color:var(--ghost);transition:transform .25s;flex-shrink:0;margin-top:4px}
.gs-say-card.open .gs-say-chev{transform:rotate(180deg)}
.gs-say-body{display:none;padding:.75rem 1.1rem 1rem;border-top:0.5px solid var(--bdr)}
.gs-say-card.open .gs-say-body{display:block}
.gs-say-why{font-size:.88rem;color:var(--mid);line-height:1.8;margin-bottom:.65rem}
.gs-say-inlbl{font-size:.57rem;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);display:block;margin-bottom:.32rem}
.gs-say-alt{font-family:'Inter',sans-serif;font-size:.92rem;font-style:italic;color:var(--ink);padding:.52rem .9rem;background:var(--off);border-left:2px solid var(--green);line-height:1.5}
.gs-pres-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:1rem}
.gs-pres-card{padding:.9rem 1rem;background:var(--off);border:0.5px solid var(--bdr)}
.gs-pres-lbl{font-size:.57rem;letter-spacing:.14em;text-transform:uppercase;color:var(--soft);display:block;margin-bottom:.35rem}
.gs-pres-txt{font-size:.78rem;color:var(--mid);line-height:1.65}

/* NOVA INFO */
.gs-nova-card{border:0.5px solid var(--bdr);padding:1.5rem;margin-bottom:.5rem;cursor:pointer;transition:background .2s;display:block;text-align:left;width:100%;font-family:'Montserrat',sans-serif;background:var(--white)}
.gs-nova-card:hover{background:var(--off)}
.gs-nova-eye{font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.45rem}
.gs-nova-title{font-family:'Inter',sans-serif;font-size:.95rem;font-weight:400;color:var(--ink);margin-bottom:.4rem}
.gs-nova-desc{font-size:.78rem;color:var(--soft);line-height:1.7;margin-bottom:.6rem}
.gs-nova-link{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green-dark)}
.gs-nova-link::after{content:' \2192'}
.gs-lang-pills{display:flex;flex-wrap:wrap;gap:.32rem;margin-top:1rem}
.gs-lang-pill{background:var(--green-light);border:0.5px solid rgba(201,169,155,.2);padding:2px 8px;font-size:.65rem;color:var(--mid)}

@media(max-width:680px){
  .gs-landing-top{padding:2.5rem 1.25rem 0}
  .gs-rule{margin:0 1.25rem}
  .gs-cards-grid{grid-template-columns:1fr}
  .gs-card{padding:1.75rem 1.25rem;border-right:none!important}
  .gs-card:nth-child(5){border-bottom:0.5px solid var(--bdr)!important}
  .gs-card:nth-child(4){border-bottom:none!important}
  .gs-inner-nav{padding:1rem 1.25rem}
  .gs-inner-body{padding:1.75rem 1.25rem}
  .gs-pres-grid{grid-template-columns:1fr}
  .gs-first{padding:2rem 1.25rem 1rem}
  .gs-next{padding:1.75rem 1.25rem .25rem}
}

/* OUR STORY PAGE */
.story-wrap{max-width:680px;margin:0 auto;padding:3rem 2rem}
.story-mag-header{display:flex;justify-content:space-between;align-items:center;padding:.7rem 0;border-top:2px solid var(--green-dark);border-bottom:0.5px solid var(--bdr);margin-bottom:0}
.story-mag-title{font-size:.58rem;letter-spacing:.32em;text-transform:uppercase;color:var(--ink);font-weight:400}
.story-mag-issue{font-family:'Inter',sans-serif;font-size:.58rem;font-style:italic;color:var(--soft)}
.story-paper{background:var(--white);border:0.5px solid var(--bdr);margin-top:0}
.story-inner{padding:2.75rem 3rem}
.story-top-rule{display:flex;align-items:center;gap:1rem;margin-bottom:2rem}
.story-rule-line{flex:1;height:0.5px;background:var(--green-light)}
.story-rule-text{font-size:.58rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);white-space:nowrap;font-weight:400}
.story-hero{display:grid;grid-template-columns:140px 1fr;gap:2.25rem;margin-bottom:2.25rem;align-items:start}
.story-photo{width:140px;display:block}
.story-photo img{width:100%;display:block;filter:sepia(5%) contrast(1.04)}
.story-text-col{padding-top:.15rem}
.story-eye{font-size:.6rem;letter-spacing:.26em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.8rem}
.story-title{font-family:'Inter',sans-serif;font-size:clamp(1.6rem,3vw,2rem);font-weight:400;line-height:1.1;color:var(--ink);margin-bottom:.6rem}
.story-title em{font-style:italic;color:var(--green-dark)}
.story-subtitle{font-family:'Inter',sans-serif;font-size:.82rem;font-style:italic;font-weight:400;color:var(--soft);line-height:1.55}
.story-body-rule{height:0.5px;background:var(--bdr);margin:0 0 1.85rem}
.story-drop-wrap{margin-bottom:1.4rem;font-size:.88rem;color:var(--mid);line-height:1.9;font-weight:400}
.story-drop{font-family:'Inter',sans-serif;font-size:52px;font-weight:400;line-height:.82;float:left;margin:0 .06rem -.12rem 0;color:var(--ink)}
.story-body{font-size:.88rem;color:var(--mid);line-height:1.9;font-weight:400}
.story-body p{margin-bottom:1.4rem}
.story-body p:last-child{margin-bottom:0}
.story-pull{border-top:1.5px solid var(--green-dark);border-bottom:0.5px solid var(--bdr);padding:1.1rem 0;margin:1.85rem 0;text-align:center}
.story-pull p{font-family:'Inter',sans-serif;font-size:1rem;font-style:italic;font-weight:400;color:var(--ink);line-height:1.65;max-width:380px;margin:0 auto}
.story-sig{margin-top:2rem;padding-top:1.4rem;border-top:0.5px solid var(--bdr)}
.story-sig-name{font-family:'Inter',sans-serif;font-size:.9rem;font-style:italic;color:var(--green-dark);display:block}
.story-sig-detail{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--ghost);display:block;margin-top:.2rem}
.story-mag-footer{display:flex;justify-content:space-between;align-items:center;padding:.6rem 0;border-top:0.5px solid var(--bdr)}
.story-footer-l{font-size:.55rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ghost)}
.story-footer-r{font-family:'Inter',sans-serif;font-size:.55rem;font-style:italic;color:var(--green)}
@media(max-width:640px){
  .story-wrap{padding:2rem 1.25rem}
  .story-inner{padding:2rem 1.5rem}
  .story-hero{grid-template-columns:110px 1fr;gap:1.5rem}
  .story-photo{width:110px}
  .story-drop{font-size:40px}
}

/* STAT CARDS SECTION */
.stat-cards-section{padding:4rem 3rem;border-top:0.5px solid var(--bdr);background:var(--white)}
.stat-cards-inner{max-width:1000px;margin:0 auto}
.stat-cards-header{display:flex;align-items:center;gap:1rem;margin-bottom:2rem}
.stat-cards-title{font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:var(--soft);white-space:nowrap}
.stat-cards-line{flex:1;height:0.5px;background:var(--bdr)}
.stat-group{margin-bottom:2rem}
.stat-group-label{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--soft);margin-bottom:.75rem;display:flex;align-items:center;gap:.6rem}
.stat-group-label::after{content:'';flex:1;height:0.5px;background:var(--bdr)}
.stat-cards-grid{display:flex;flex-direction:column;gap:.45rem}
.stat-card{background:var(--white);border:0.5px solid var(--bdr);border-radius:10px;padding:.8rem 1.05rem;display:flex;align-items:flex-start;gap:.8rem;transition:border-color .15s}
.stat-card:hover{border-color:rgba(29,158,117,.45)}
.stat-icon{width:32px;height:32px;border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px}
.si-rose{background:var(--green-light);color:var(--green-dark)}
.si-blue{background:var(--green-light);color:var(--green-dark)}
.si-sage{background:var(--green-light);color:var(--green-dark)}
.stat-card-text{}
.stat-card-stat{font-family:'Inter',sans-serif;font-size:1.05rem;font-weight:400;color:var(--ink);line-height:1.45;margin-bottom:.18rem}
.stat-card-stat em{font-style:italic;color:var(--green-dark)}
.stat-card-src{font-size:.68rem;color:var(--ghost);letter-spacing:.02em}
@media(max-width:640px){
  .stat-cards-section{padding:3rem 1.25rem}
}

/* CRISIS STRIP */
.crisis-strip{background:var(--green-dark);padding:.75rem 2rem .65rem;width:100%}
.crisis-strip-inner{max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:.35rem}
.crisis-strip-label{font-size:.57rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);font-weight:400;display:block}
.crisis-strip-numbers{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;align-items:flex-start}
.crisis-num{display:flex;align-items:flex-start;gap:.4rem}
.crisis-flag{font-size:.8rem;line-height:1.6;flex-shrink:0}
.crisis-num-detail{display:flex;flex-direction:column;gap:.05rem}
.crisis-tel{font-size:.67rem;color:rgba(255,255,255,.82);letter-spacing:.01em;text-decoration:none;transition:color .15s;white-space:nowrap;line-height:1.3}
.crisis-tel:hover{color:#fff}
.crisis-tel strong{color:#fff;font-weight:400}
.crisis-hours{font-size:.56rem;color:rgba(255,255,255,.3);letter-spacing:.02em;line-height:1.2}
.crisis-strip-footer{padding-top:.25rem;border-top:0.5px solid rgba(255,255,255,.06);margin-top:.1rem}
.crisis-strip-note{font-size:.58rem;color:rgba(255,255,255,.35);letter-spacing:.02em}
.crisis-strip-note strong{color:rgba(255,255,255,.6);font-weight:400}
.crisis-link{background:none;border:none;color:var(--green);font-size:.58rem;cursor:pointer;font-family:'Montserrat',sans-serif;padding:0;text-decoration:underline;text-underline-offset:2px;transition:color .15s}
.crisis-link:hover{color:#fff}
@media(max-width:900px){
  .crisis-strip{padding:.55rem 1.5rem .45rem}
  .crisis-strip-numbers{gap:.5rem 1rem}
}
@media(max-width:640px){
  .crisis-strip{padding:.5rem 1.25rem .4rem}
  .crisis-strip-numbers{gap:.4rem .9rem}
  .crisis-hours{display:none}
  .crisis-tel{font-size:.65rem}
}

/* NEWSLETTER */
.newsletter-section{background:var(--blush-light);border-top:3px solid var(--blush);padding:4rem 3rem}
.partners-section{background:var(--white);border-top:1px solid var(--border);padding:3.5rem 3rem}
.partners-inner{max-width:960px;margin:0 auto;text-align:center}
.partners-eye{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:var(--soft);display:block;margin-bottom:1.6rem}
.partners-logos{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:2rem 3.5rem}
.partner-logo{display:inline-flex;align-items:center;opacity:.9;transition:opacity .2s}
.partner-logo:hover{opacity:1}
.partner-logo img{width:auto;height:auto;max-width:200px;max-height:110px;display:block}
.newsletter-inner{max-width:960px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.newsletter-text{}
.newsletter-eye{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.75rem}
.newsletter-title{font-family:'Inter',sans-serif;font-size:1.75rem;font-weight:400;line-height:1.15;color:var(--ink);margin-bottom:.85rem}
.newsletter-title em{font-style:italic;color:var(--green-dark)}
.newsletter-body{font-size:.85rem;color:var(--mid);line-height:1.85}
.newsletter-form{}
.newsletter-note{font-size:.72rem;color:var(--soft);margin-bottom:1.25rem;line-height:1.65;font-style:italic}
.nl-input-row{display:flex;border:0.5px solid var(--bdr);background:var(--white);overflow:hidden;margin-bottom:.75rem}
.nl-input{flex:1;border:none;background:transparent;padding:.85rem 1.1rem;font-family:'Montserrat',sans-serif;font-size:.88rem;color:var(--ink);outline:none}
.nl-input::placeholder{color:var(--ghost)}
.nl-btn{background:var(--green-dark);color:#fff;border:none;padding:.85rem 1.5rem;font-family:'Montserrat',sans-serif;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;transition:background .2s;white-space:nowrap;font-weight:400}
.nl-btn:hover{background:var(--green-dark)}
.nl-privacy{font-size:.65rem;color:var(--ghost);line-height:1.6}
.nl-msg{display:none;font-size:.74rem;color:var(--ink);font-style:italic;line-height:1.6;margin-bottom:.6rem}
.nl-privacy button{background:none;border:none;color:var(--soft);font-size:.65rem;cursor:pointer;font-family:'Montserrat',sans-serif;text-decoration:underline;text-underline-offset:2px;padding:0}
.nl-privacy button:hover{color:var(--ink)}
.nl-success{display:none;padding:1.25rem 1.5rem;background:var(--white);border:0.5px solid rgba(201,169,155,.3);border-left:3px solid var(--green)}
.nl-success.show{display:block}
.nl-success p{font-family:'Inter',sans-serif;font-size:.95rem;font-style:italic;color:var(--ink);line-height:1.5}
.nl-success span{font-size:.75rem;color:var(--soft);display:block;margin-top:.35rem}
@media(max-width:780px){
  .newsletter-inner{grid-template-columns:1fr;gap:2rem}
  .newsletter-section{padding:3rem 1.25rem}
}

/* COLLABORATION PAGE */
.collab-hero{padding:4rem 3rem 3rem;max-width:860px;margin:0 auto}
.collab-doc{max-width:760px;margin:0 auto;padding:0 3rem 4rem}
.collab-doc p{font-size:.95rem;color:var(--mid);line-height:1.85;font-weight:400;margin-bottom:1rem}
.collab-doc p.cd-lead{font-family:'Inter',sans-serif;font-size:clamp(1.2rem,2.2vw,1.5rem);font-weight:400;line-height:1.45;color:var(--ink);margin-bottom:1.1rem}
.collab-doc p.cd-build{font-size:1.02rem;color:var(--ink);font-weight:400;margin:1.6rem 0 .5rem}
.collab-doc p.cd-emph{color:var(--ink);font-weight:400;font-size:1.02rem;margin-top:.3rem}
.collab-doc p.cd-close{font-family:'Inter',sans-serif;font-size:1.15rem;font-weight:400;color:var(--ink);text-align:center;margin:3rem 0 0;line-height:1.5}
.cd-section{margin-top:2.5rem;padding-top:2.25rem;border-top:1px solid var(--border)}
.cd-section h3{font-family:'Inter',sans-serif;font-size:1.3rem;font-weight:400;color:var(--ink);margin-bottom:.25rem}
.cd-tagline{display:block;font-family:'Inter',sans-serif;font-style:italic;font-size:1rem;color:var(--green);margin-bottom:.9rem}
.cd-actions{display:flex;gap:.85rem;flex-wrap:wrap;justify-content:center;margin-top:3rem}
.cd-btn{display:inline-block;font-family:'Montserrat',sans-serif;font-size:.8rem;font-weight:500;letter-spacing:.04em;padding:.9rem 2rem;border-radius:3px;cursor:pointer;text-decoration:none;border:1px solid var(--green);transition:all .2s}
.cd-btn-primary{background:var(--green);color:var(--white)}
.cd-btn-primary:hover{background:var(--green-dark);border-color:var(--green-dark)}
.cd-btn-outline{background:transparent;color:var(--green)}
.cd-btn-outline:hover{background:var(--green);color:var(--white)}
.collab-intro{font-size:.92rem;color:var(--mid);line-height:1.95;max-width:620px;margin-bottom:3rem;border-left:3px solid var(--green);padding-left:1.5rem}
.collab-sections{display:flex;flex-direction:column;gap:0;max-width:960px;margin:0 auto;padding:0 3rem 5rem}
.collab-section{display:grid;grid-template-columns:260px 1fr;gap:4rem;padding:3.5rem 0;border-bottom:0.5px solid var(--border)}
.collab-section:last-child{border-bottom:none}
.collab-left{}
.collab-num{font-family:'Inter',sans-serif;font-size:3rem;font-weight:400;color:var(--green-light);line-height:1;display:block;margin-bottom:.5rem}
.collab-section-eye{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.5rem}
.collab-section-title{font-family:'Inter',sans-serif;font-size:1.4rem;font-weight:400;color:var(--ink);line-height:1.2}
.collab-section-title em{font-style:italic;color:var(--green-dark)}
.collab-right{}
.collab-body{font-size:1rem;color:var(--mid);line-height:1.95;margin-bottom:1.75rem}
.collab-body strong{font-weight:400;color:var(--ink)}
.collab-points{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.75rem}
.collab-point{display:flex;align-items:flex-start;gap:.75rem}
.collab-point-dot{width:5px;height:5px;border-radius:50%;background:var(--green);flex-shrink:0;margin-top:.55rem}
.collab-point-text{font-size:.85rem;color:var(--mid);line-height:1.7}
.collab-point-text strong{font-weight:400;color:var(--ink)}
.collab-form{border:0.5px solid var(--border);overflow:hidden;margin-top:.5rem}
.collab-form-field{display:flex;flex-direction:column;border-bottom:0.5px solid var(--border)}
.collab-form-field:last-of-type{border-bottom:none}
.collab-form-field label{font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;color:var(--green);padding:.65rem 1.1rem .2rem;border-bottom:0.5px solid var(--border)}
.collab-form-field input,.collab-form-field select,.collab-form-field textarea{border:none;background:transparent;padding:.5rem 1.1rem .65rem;font-family:'Montserrat',sans-serif;font-size:.88rem;color:var(--ink);outline:none;resize:none}
.collab-form-field textarea{min-height:80px;line-height:1.6}
.collab-submit{width:100%;background:var(--green);color:#fff;border:none;padding:.9rem 2rem;font-family:'Montserrat',sans-serif;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .2s;font-weight:400;text-align:left;display:flex;justify-content:space-between;align-items:center}
.collab-submit:hover{background:var(--green-dark)}
.collab-submit::after{content:'→';font-size:1rem}
.collab-cta-link{display:inline-flex;align-items:center;gap:.5rem;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--green);text-decoration:none;cursor:pointer;background:none;border:none;font-family:'Montserrat',sans-serif;transition:color .2s;padding:0}
.collab-cta-link:hover{color:var(--green-dark)}
.collab-cta-link::after{content:'→';font-size:.9rem}
.collab-success{display:none;padding:1.25rem 1.5rem;background:var(--green-light);border:0.5px solid rgba(29,158,117,.2)}
.collab-success.show{display:block}
.collab-success p{font-family:'Inter',sans-serif;font-size:.92rem;font-style:italic;color:var(--green-dark);line-height:1.5}
.collab-bottom-strip{background:var(--green-dark);padding:3.5rem 3rem}
.collab-bottom-inner{max-width:960px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.collab-bottom-title{font-family:'Inter',sans-serif;font-size:2rem;font-weight:400;color:#fff;line-height:1.2;margin-bottom:.75rem}
.collab-bottom-title em{font-style:italic;color:var(--green-light)}
.collab-bottom-sub{font-size:.85rem;color:rgba(255,255,255,.6);line-height:1.85}
.collab-bottom-right{display:flex;flex-direction:column;gap:.75rem}
.collab-bottom-item{display:flex;align-items:flex-start;gap:.85rem;padding:.9rem 1.1rem;background:rgba(255,255,255,.06);border:0.5px solid rgba(255,255,255,.1)}
.collab-bottom-item-label{font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--green-light);display:block;margin-bottom:.2rem;flex-shrink:0;width:80px;padding-top:2px}
.collab-bottom-item-val{font-size:.85rem;color:rgba(255,255,255,.75);line-height:1.5}
.collab-bottom-item-val a{color:var(--green-light);text-decoration:none}
.collab-bottom-item-val a:hover{color:#fff}
@media(max-width:900px){
  .collab-section{grid-template-columns:1fr;gap:1.5rem}
  .collab-sections{padding:0 2rem 4rem}
  .collab-hero{padding:3rem 2rem 2rem}
  .collab-bottom-inner{grid-template-columns:1fr;gap:2rem}
  .collab-bottom-strip{padding:2.5rem 2rem}
}
@media(max-width:640px){
  .collab-sections{padding:0 1.25rem 3rem}
  .collab-hero{padding:2.5rem 1.25rem 1.5rem}
  .collab-doc{padding:0 1.25rem 3rem}
}

/* PHYSICAL RECOVERY SUBVIEW */
.gs-recovery-grid{display:flex;flex-direction:column;gap:0}
.gs-rec-item{border-bottom:0.5px solid var(--border);overflow:hidden}
.gs-rec-item:first-child{border-top:0.5px solid var(--border)}
.gs-rec-header{display:flex;align-items:flex-start;justify-content:space-between;padding:1.25rem 0;cursor:pointer;gap:1rem;background:none;border:none;width:100%;text-align:left;font-family:'Montserrat',sans-serif}
.gs-rec-header:hover .gs-rec-title{color:var(--green)}
.gs-rec-left{display:flex;align-items:flex-start;gap:1rem}
.gs-rec-num{font-family:'Inter',sans-serif;font-size:.75rem;color:var(--green-light);min-width:22px;padding-top:3px;flex-shrink:0}
.gs-rec-title{font-family:'Inter',sans-serif;font-size:1rem;font-weight:400;color:var(--ink);transition:color .2s;line-height:1.3}
.gs-rec-chev{font-size:.65rem;color:var(--ghost);transition:transform .25s;flex-shrink:0;margin-top:5px}
.gs-rec-item.open .gs-rec-chev{transform:rotate(180deg)}
.gs-rec-body{display:none;padding-bottom:1.75rem;padding-left:2.35rem}
.gs-rec-item.open .gs-rec-body{display:block}
.gs-rec-text{font-size:.85rem;color:var(--mid);line-height:1.9;margin-bottom:1rem}
.gs-rec-text:last-child{margin-bottom:0}
.gs-rec-text strong{font-weight:400;color:var(--ink)}
.gs-rec-text em{font-style:italic;color:var(--ink)}
.gs-rec-note{background:var(--green-light);border-left:3px solid var(--green);padding:.75rem 1rem;margin-top:.75rem;font-size:.8rem;color:var(--green-dark);line-height:1.7}
.gs-rec-note strong{font-weight:500}

/* MAGAZINE FEED */
.journal-section{background:var(--cream);border-top:0.5px solid var(--border);padding:5rem 3rem}
.journal-inner{max-width:1200px;margin:0 auto}
.journal-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2.5rem;padding-bottom:1.75rem;border-bottom:0.5px solid var(--border);flex-wrap:wrap;gap:1.25rem}
.journal-title-group{}
.journal-eye{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.45rem;font-weight:400}
.journal-title{font-family:'Inter',sans-serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:400;color:var(--green-dark);line-height:1.1}
.journal-title em{font-style:italic}
.journal-tabs{display:flex;gap:.25rem;flex-wrap:wrap}
.jtab{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.38rem .85rem;border:0.5px solid var(--border);background:transparent;color:var(--soft);cursor:pointer;font-family:'Montserrat',sans-serif;font-weight:400;transition:all .15s}
.jtab.active,.jtab:hover{background:var(--green-dark);color:#fff;border-color:var(--green-dark)}
.journal-featured{display:grid;grid-template-columns:1fr 1fr;border:0.5px solid var(--border);margin-bottom:.5rem}
.jcard-big{padding:2rem;border-right:0.5px solid var(--border);cursor:pointer;transition:background .15s,border-color .15s;background:var(--white)}
.jcard-big:hover{background:var(--sage)}
.jcard-big:last-child{border-right:none}
.jcard-sm-grid{display:grid;grid-template-columns:1fr 1fr 1fr;border:0.5px solid var(--border);border-top:none;margin-bottom:.5rem}
.jcard-sm{padding:1.5rem;border-right:0.5px solid var(--border);cursor:pointer;transition:background .15s;background:var(--white)}
.jcard-sm:hover{background:var(--sage)}
.jcard-sm:last-child{border-right:none}
.jcard-pillar{font-size:.57rem;letter-spacing:.18em;text-transform:uppercase;display:inline-block;padding:3px 8px;margin-bottom:.75rem;font-weight:400}
.jp-history{background:var(--green-light);color:var(--green-dark)}
.jp-research{background:#e6f1fb;color:#185FA5}
.jp-art{background:#faeeda;color:#854F0B}
.jp-nature{background:#EAF3DE;color:#3B6D11}
.journal-intro{max-width:680px;margin:0 auto 2.75rem;text-align:center}
.journal-lead{font-family:'Inter',sans-serif;font-size:clamp(1.18rem,2.1vw,1.46rem);font-weight:400;line-height:1.5;color:var(--ink)}
.journal-intro .journal-tabs{display:flex;justify-content:center;flex-wrap:wrap;gap:.4rem;margin-top:1.7rem}
.jlist{max-width:720px;margin:0 auto}
.jentry{display:flex;gap:1.75rem;align-items:center;padding:1.9rem 0;border-bottom:1px solid var(--border);cursor:pointer;transition:opacity .2s}
.jentry:first-child{border-top:1px solid var(--border)}
.jentry:hover{opacity:.72}
.jentry-thumb{flex:0 0 188px;width:188px;height:120px;border-radius:6px;overflow:hidden;background:var(--green-light);color:var(--green);display:flex;align-items:center;justify-content:center}
.jentry-thumb svg{width:100%;height:100%;display:block}
.jentry-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.jentry-thumb-video{position:relative}
.jentry-thumb-video::after{content:"";position:absolute;z-index:1;left:50%;top:50%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:rgba(0,0,0,.5)}
.jentry-thumb-video::before{content:"";position:absolute;z-index:2;left:50%;top:50%;transform:translate(-44%,-50%);border-style:solid;border-width:8px 0 8px 13px;border-color:transparent transparent transparent #fff}
.jentry-text{flex:1;min-width:0}
.jentry-pillar{font-family:'Montserrat',sans-serif;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.5rem}
.jentry-title{font-family:'Inter',sans-serif;font-size:1.18rem;font-weight:400;line-height:1.32;color:var(--ink);margin-bottom:.5rem}
.jentry-title em{font-style:italic}
.jentry-excerpt{font-size:.9rem;color:var(--mid);line-height:1.7;font-weight:400;margin-bottom:.55rem}
.jentry-meta{font-size:.72rem;color:var(--soft);font-weight:400}
.jshare{max-width:600px;margin:3.5rem auto 0;text-align:center}
.jshare-btn{display:inline-block;font-family:'Montserrat',sans-serif;font-size:.82rem;font-weight:500;letter-spacing:.04em;color:var(--white);background:var(--green);padding:.95rem 2.4rem;border-radius:3px;text-decoration:none;transition:background .2s}
.jshare-btn:hover{background:var(--green-dark);color:var(--white)}
.jshare-note{font-size:.72rem;color:var(--soft);line-height:1.7;font-weight:400;margin-top:1.3rem}
.jshare-note a{color:var(--green);text-decoration:underline}
.jp-borders{background:#F6EAFB;color:#993556}
.jcard-title{font-family:'Inter',sans-serif;font-size:1.1rem;font-weight:400;color:var(--ink);line-height:1.3;margin-bottom:.6rem}
.jcard-title em{font-style:italic;color:var(--green-dark)}
.jcard-title-sm{font-family:'Inter',sans-serif;font-size:.92rem;font-weight:400;color:var(--ink);line-height:1.35;margin-bottom:.45rem}
.jcard-title-sm em{font-style:italic;color:var(--green-dark)}
.jcard-body{font-size:.82rem;color:var(--soft);line-height:1.75;margin-bottom:.85rem;font-weight:400}
.jcard-body-sm{font-size:.78rem;color:var(--soft);line-height:1.7;font-weight:400}
.jcard-meta{display:flex;align-items:center;gap:.5rem;font-size:.65rem;color:var(--ghost);letter-spacing:.04em}
.jmeta-dot{width:3px;height:3px;border-radius:50%;background:var(--border)}
.jcard-arrow{font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--green);display:block;margin-top:.65rem;font-weight:400}
.journal-series{background:var(--green-dark);padding:2rem;border:0.5px solid var(--green-dark);margin-bottom:.5rem}
.js-label{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.4);display:block;margin-bottom:.35rem}
.js-title{font-family:'Inter',sans-serif;font-size:1rem;font-weight:400;color:#fff;font-style:italic;margin-bottom:1.25rem}
.js-cards{display:flex;gap:.6rem;overflow-x:auto;padding-bottom:.25rem}
.js-card{background:rgba(255,255,255,.07);border:0.5px solid rgba(255,255,255,.12);padding:.85rem 1rem;flex-shrink:0;width:175px;cursor:pointer;transition:background .15s;text-decoration:none}
.js-card:hover{background:rgba(255,255,255,.13)}
.js-flag{font-size:1.1rem;display:block;margin-bottom:.35rem}
.js-card-title{font-size:.75rem;font-weight:400;color:rgba(255,255,255,.8);line-height:1.45;font-family:'Montserrat',sans-serif}
.journal-footer{display:flex;justify-content:space-between;align-items:center;padding-top:1.25rem;border-top:0.5px solid var(--border)}
.journal-footer-note{font-size:.72rem;color:var(--soft);font-weight:400}
@media(max-width:860px){
  .journal-featured{grid-template-columns:1fr}
  .jcard-big{border-right:none!important;border-bottom:0.5px solid var(--border)}
  .jcard-sm-grid{grid-template-columns:1fr}
  .jcard-sm{border-right:none!important;border-bottom:0.5px solid var(--border)}
  .jcard-sm:last-child{border-bottom:none}
  .journal-section{padding:4rem 1.25rem}
}

/* ARTICLE PAGES */
.article-page{max-width:100%}
.article-hero{max-width:860px;margin:0 auto;padding:3rem 3rem 2.5rem}
.article-pillar{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;display:inline-block;padding:4px 10px;margin-bottom:1.5rem;font-weight:400}
.ap-history{background:var(--green-light);color:var(--green-dark)}
.ap-art{background:#faeeda;color:#854F0B}
.ap-nature{background:#EAF3DE;color:#3B6D11}
.ap-research{background:#e6f1fb;color:#185FA5}
.article-title{font-family:'Inter',sans-serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:400;line-height:1.1;color:var(--ink);margin-bottom:1.1rem;letter-spacing:-.02em}
.article-title em{font-style:italic;color:var(--green-dark)}
.article-subtitle{font-size:1rem;color:var(--mid);line-height:1.8;max-width:580px;margin-bottom:1.75rem;font-weight:400}
.article-meta{display:flex;align-items:center;gap:.85rem;font-size:.7rem;color:var(--soft);letter-spacing:.04em;padding-top:1.25rem;border-top:0.5px solid var(--border);flex-wrap:wrap}
.ameta-dot{width:3px;height:3px;border-radius:50%;background:var(--border)}
.article-back{display:inline-flex;align-items:center;gap:.4rem;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--green);background:none;border:none;cursor:pointer;font-family:'Montserrat',sans-serif;margin-bottom:1.5rem;padding:0;transition:color .15s}
.article-back:hover{color:var(--green-dark)}
.article-back::before{content:'←';font-size:.8rem}
.illustration-wrap{background:var(--white);border-top:0.5px solid var(--border);border-bottom:0.5px solid var(--border);margin:0 0 3rem}
.illustration-wrap svg{max-width:100%;display:block}
.article-body{max-width:680px;margin:0 auto;padding:0 3rem 5rem}
.article-body p{font-size:1.05rem;color:var(--mid);line-height:1.95;margin-bottom:1.75rem;font-weight:400}
.article-body p:first-child::first-letter{font-family:'Inter',sans-serif;font-size:3.5rem;font-weight:400;line-height:.85;float:left;margin:0 .08rem -.12rem 0;color:var(--ink)}
.article-body h2{font-family:'Inter',sans-serif;font-size:1.35rem;font-weight:400;color:var(--ink);margin:2.5rem 0 1rem;line-height:1.3}
.article-body h2 em{font-style:italic;color:var(--green-dark)}
.pull-quote{border-top:2px solid var(--green-dark);border-bottom:0.5px solid var(--border);padding:1.5rem 0;margin:2.5rem 0;text-align:center}
.pull-quote p{font-family:'Inter',sans-serif;font-size:1.15rem;font-style:italic;font-weight:400;color:var(--ink);line-height:1.65;max-width:520px;margin:0 auto}
.items-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:0.5px solid var(--border);margin:2rem 0}
.item-card{padding:1.25rem 1.5rem;border-right:0.5px solid var(--border);border-bottom:0.5px solid var(--border)}
.item-card:nth-child(2n){border-right:none}
.item-card:nth-last-child(-n+2){border-bottom:none}
.item-num{font-family:'Inter',sans-serif;font-size:.8rem;color:var(--green-light);display:block;margin-bottom:.3rem}
.item-name{font-size:.88rem;font-weight:400;color:var(--ink);display:block;margin-bottom:.3rem}
.item-desc{font-size:.78rem;color:var(--soft);line-height:1.65}
.article-source{background:var(--green-light);border-left:3px solid var(--green);padding:1.25rem 1.5rem;margin-top:2.5rem}
.article-source .source-label{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.4rem}
.article-source .source-text{font-size:.85rem;color:var(--green-dark);line-height:1.75}
.article-footer-bar{max-width:680px;margin:0 auto;padding:0 3rem 4rem}
.afooter-rule{height:0.5px;background:var(--border);margin-bottom:1.5rem}
.journal-nav-bottom{display:flex;gap:.5rem;flex-wrap:wrap}
@media(max-width:640px){
  .article-hero{padding:2rem 1.25rem 1.5rem}
  .article-body{padding:0 1.25rem 4rem}
  .article-footer-bar{padding:0 1.25rem 3rem}
  .items-grid{grid-template-columns:1fr}
  .item-card{border-right:none!important}
}

/* IMPACT STRIP */
.impact-strip{background:var(--green-dark);padding:3rem}
.impact-inner{max-width:960px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap}
.impact-item{text-align:center;padding:1rem 3rem;flex:1;min-width:160px}
.impact-n{font-family:'Inter',sans-serif;font-size:clamp(2.2rem,5vw,3.2rem);font-weight:400;color:#fff;display:block;line-height:1;margin-bottom:.5rem}
.impact-l{font-size:.72rem;color:rgba(255,255,255,.6);letter-spacing:.08em;text-transform:uppercase;font-weight:400;line-height:1.5}
.impact-divider{width:0.5px;height:60px;background:rgba(255,255,255,.15);flex-shrink:0}

/* VICTORIA QUOTE */
.home-quote-section{background:var(--white);padding:5rem 3rem;border-top:0.5px solid var(--border)}
.home-quote-inner{max-width:720px;margin:0 auto;text-align:center}
.home-quote-rule{width:40px;height:2px;background:var(--green);margin:0 auto 2rem}
.home-quote-text{font-family:'Inter',sans-serif;font-size:clamp(1.2rem,2.5vw,1.65rem);font-weight:400;font-style:italic;color:var(--ink);line-height:1.6;margin-bottom:1.5rem}
.home-quote-attr{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--soft)}

/* WHAT MIMATIS OFFERS */
.home-offers-section{background:var(--off);padding:5rem 3rem;border-top:0.5px solid var(--border)}
.home-offers-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
.home-offers-eye{font-size:.62rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:1rem}
.home-offers-title{font-family:'Inter',sans-serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:400;color:var(--ink);line-height:1.2;margin-bottom:1.25rem}
.home-offers-title em{font-style:italic;color:var(--green-dark)}
.home-offers-sub{font-size:1rem;color:var(--mid);line-height:1.85;margin-bottom:1.75rem;font-weight:400}
.home-offers-link{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--green);cursor:pointer;display:inline-block;border-bottom:1px solid rgba(29,158,117,.3);padding-bottom:2px;transition:border-color .15s;text-decoration:none;background:none;border-top:none;border-left:none;border-right:none;font-family:'Montserrat',sans-serif}
.home-offers-link:hover{border-bottom-color:var(--green)}
.home-offers-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:0.5px solid var(--border)}
.home-offer-card{padding:1.5rem;border-right:0.5px solid var(--border);border-bottom:0.5px solid var(--border);background:var(--white)}
.home-offer-card:nth-child(2n){border-right:none}
.home-offer-card:nth-child(5),.home-offer-card:nth-child(6){border-bottom:none}
.hoc-num{font-family:'Inter',sans-serif;font-size:.8rem;color:var(--green-light);display:block;margin-bottom:.4rem}
.hoc-title{font-size:.88rem;font-weight:500;color:var(--ink);display:block;margin-bottom:.4rem;letter-spacing:.01em}
.hoc-body{font-size:.82rem;color:var(--soft);line-height:1.7;font-weight:400;display:block}

@media(max-width:860px){
  .impact-inner{gap:0}
  .impact-item{padding:.75rem 1.5rem}
  .impact-divider{display:none}
  .home-offers-inner{grid-template-columns:1fr}
  .home-quote-section,.home-offers-section{padding:3.5rem 1.5rem}
  .impact-strip{padding:2rem 1.5rem}
}
@media(max-width:640px){
  .home-offers-grid{grid-template-columns:1fr}
  .home-offer-card{border-right:none!important}
  .home-offer-card:nth-child(5){border-bottom:0.5px solid var(--border)!important}
}

/* HERO REDESIGN */
.hero-section{padding:4rem 3rem 3.5rem;background:var(--white);border-bottom:0.5px solid var(--border)}
.hero-inner{max-width:760px;margin:0 auto;position:relative;z-index:1}
.hero-eyebrow{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:1.25rem;font-weight:400}


.hero-stat-item:last-child{border-bottom:none}




/* WHY SECTION */
.why-section{background:var(--green-dark);padding:5rem 3rem}
.why-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:start}
.why-eye{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:rgba(255,255,255,.45);display:block;margin-bottom:1.25rem}
.why-title{font-family:'Inter',sans-serif;font-size:clamp(1.6rem,3vw,2.4rem);font-weight:400;color:#fff;line-height:1.15}
.why-title em{font-style:italic;color:var(--green-light)}
.why-body{font-size:1rem;color:rgba(255,255,255,.7);line-height:1.9;margin-bottom:1.25rem;font-weight:400}
.why-body:last-of-type{margin-bottom:1.75rem}
.why-cta{background:transparent;border:0.5px solid rgba(255,255,255,.3);color:#fff;padding:.75rem 1.5rem;font-family:'Montserrat',sans-serif;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:all .2s;font-weight:400}
.why-cta:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.5)}

@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:2.5rem}
  .hero-section{padding:3rem 1.5rem}
  .why-inner{grid-template-columns:1fr;gap:2.5rem}
  .why-section{padding:3.5rem 1.5rem}
  
  
  .hero-stat-item:last-child{border-right:none;border-bottom:none}
}
@media(max-width:640px){
  
  
}

/* ── HERO REDESIGN ── */
.hero-section{padding:5rem 3rem 5.5rem;background:var(--cream);border-bottom:none;position:relative;overflow:hidden}
.hero-section::before{content:'';position:absolute;top:-120px;right:-80px;width:480px;height:480px;background:radial-gradient(circle,var(--sage-mid) 0%,transparent 70%);opacity:.45;pointer-events:none}
.hero-section::after{content:'';position:absolute;bottom:-80px;left:-60px;width:320px;height:320px;background:radial-gradient(circle,var(--blush) 0%,transparent 70%);opacity:.2;pointer-events:none}
.hero-inner{max-width:760px;margin:0 auto;position:relative;z-index:1}
.hero-eyebrow{font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:1.5rem;font-weight:400}
.hero-title{font-family:'Inter',sans-serif;font-size:clamp(2.4rem,6vw,4rem);font-weight:400;line-height:1.1;color:var(--ink);margin-bottom:1.5rem;letter-spacing:-.02em}
.hero-title em{font-style:italic;color:var(--green-dark)}
.hero-sub{font-size:1.1rem;color:var(--mid);line-height:1.85;max-width:580px;margin-bottom:2.5rem;font-weight:400}
.hero-btns{display:flex;gap:.75rem;flex-wrap:wrap}
.btn-ink{background:var(--green);color:#fff;border:none;padding:.95rem 2rem;font-family:'Montserrat',sans-serif;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border-radius:4px;font-weight:400;transition:background .2s}
.btn-ink:hover{background:var(--green-dark)}
.btn-bdr{background:transparent;color:var(--green-dark);border:1.5px solid var(--green);padding:.9rem 1.85rem;font-family:'Montserrat',sans-serif;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border-radius:4px;font-weight:400;transition:all .2s}
.btn-bdr:hover{background:var(--green);color:#fff}

/* ── IMPACT STRIP — warm blush ── */
.impact-strip{background:var(--blush-light);border-top:3px solid var(--blush);border-bottom:3px solid var(--blush);padding:2.5rem 3rem}
.impact-inner{max-width:960px;margin:0 auto;display:flex;align-items:stretch;justify-content:center;flex-wrap:wrap}
.impact-item{text-align:center;padding:1rem 2.5rem;flex:1;min-width:140px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.impact-n{font-family:'Inter',sans-serif;font-size:clamp(2rem,4vw,2.8rem);font-weight:400;color:var(--blush-dark);display:block;line-height:1;margin-bottom:.5rem}
.impact-l{font-size:.72rem;color:var(--mid);letter-spacing:.06em;line-height:1.5;font-weight:400}
.impact-divider{width:1px;background:var(--blush);opacity:.4;margin:1rem 0;flex-shrink:0}

/* ── WHY SECTION — warm sage ── */
.why-section{background:var(--sage);padding:5.5rem 3rem;border-top:0.5px solid var(--sage-mid)}
.why-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1.4fr;gap:6rem;align-items:start}
.why-eye{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:1.25rem;font-weight:400}
.why-title{font-family:'Inter',sans-serif;font-size:clamp(1.7rem,3vw,2.5rem);font-weight:400;color:var(--ink);line-height:1.15}
.why-title em{font-style:italic;color:var(--green-dark)}
.why-body{font-size:1rem;color:var(--mid);line-height:1.9;margin-bottom:1.25rem;font-weight:400}
.why-body:last-of-type{margin-bottom:1.75rem}
.why-cta{background:var(--green);border:none;color:#fff;padding:.85rem 1.75rem;font-family:'Montserrat',sans-serif;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:all .2s;border-radius:4px;font-weight:400}
.why-cta:hover{background:var(--green-dark)}

/* ── WHAT MIMATIS OFFERS ── */
.home-offers-section{background:var(--white);padding:5.5rem 3rem;border-top:0.5px solid var(--border)}
.home-offers-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start}
.home-offers-eye{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:1rem}
.home-offers-title{font-family:'Inter',sans-serif;font-size:clamp(1.6rem,3vw,2.2rem);font-weight:400;color:var(--ink);line-height:1.2;margin-bottom:1.25rem}
.home-offers-title em{font-style:italic;color:var(--green-dark)}
.home-offers-sub{font-size:1rem;color:var(--mid);line-height:1.85;margin-bottom:1.75rem;font-weight:400}
.home-offers-link{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--green);cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;border:none;background:none;padding:0;font-family:'Montserrat',sans-serif;transition:color .15s}
.home-offers-link:hover{color:var(--green-dark)}
.home-offers-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
.home-offer-card{padding:1.5rem 1.25rem;background:var(--cream);border-radius:8px;border:1.5px solid transparent;transition:border-color .2s,background .2s}
.home-offer-card:hover{border-color:var(--green);background:var(--white)}
.hoc-num{font-family:'Inter',sans-serif;font-size:.75rem;color:var(--green);display:block;margin-bottom:.5rem;font-weight:400}
.hoc-title{font-size:.92rem;font-weight:500;color:var(--ink);display:block;margin-bottom:.45rem;line-height:1.3}
.hoc-body{font-size:.82rem;color:var(--soft);line-height:1.7;font-weight:400;display:block}

/* ── COUNTRY SELECTOR ── */
.home-country{padding:5rem 3rem;background:var(--cream);border-top:0.5px solid var(--border)}
.hc-inner{max-width:1100px;margin:0 auto}
.hc-head{margin-bottom:2.5rem}
.hc-eye{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.65rem}
.hc-title{font-family:'Inter',sans-serif;font-size:clamp(1.4rem,2.5vw,1.9rem);font-weight:400;color:var(--ink);margin-bottom:.65rem}
.hc-sub{font-size:.92rem;color:var(--soft);line-height:1.7;max-width:520px;font-weight:400}

/* ── STAT CARDS ── */
.stat-cards-section{background:var(--white);padding:5rem 3rem;border-top:0.5px solid var(--border)}
.stat-cards-inner{max-width:1100px;margin:0 auto}
.stat-cards-header{display:flex;align-items:center;gap:1rem;margin-bottom:2.5rem}
.stat-cards-title{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--soft);white-space:nowrap}
.stat-cards-line{flex:1;height:0.5px;background:var(--border)}
.stat-group{margin-bottom:2.5rem}
.stat-group-label{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--soft);margin-bottom:.85rem;display:flex;align-items:center;gap:.6rem}
.stat-group-label::after{content:'';flex:1;height:0.5px;background:var(--border)}
.stat-cards-grid{display:flex;flex-direction:column;gap:.4rem}
.stat-card{background:var(--cream);border:1.5px solid transparent;border-radius:8px;padding:.9rem 1.1rem;display:flex;align-items:flex-start;gap:.85rem;transition:border-color .15s,background .15s}
.stat-card:hover{border-color:var(--green);background:var(--white)}
.stat-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:15px}
.si-rose{background:var(--blush-light);color:var(--blush-dark)}
.si-blue{background:#EBF4FF;color:#1A5FAB}
.si-sage{background:var(--green-light);color:var(--green-dark)}
.stat-card-stat{font-family:'Inter',sans-serif;font-size:1rem;font-weight:400;color:var(--ink);line-height:1.5;margin-bottom:.2rem}
.stat-card-stat em{font-style:italic;color:var(--green-dark)}
.stat-card-src{font-size:.65rem;color:var(--soft);letter-spacing:.03em}

/* ── INFO STRIP ── */
.info-strip{background:var(--green-dark);padding:3.5rem 3rem}
.info-strip-inner{max-width:1100px;margin:0 auto}
.info-strip-title{font-family:'Inter',sans-serif;font-size:1.3rem;font-weight:400;color:#fff;margin-bottom:.65rem;font-style:italic}
.info-strip-body{font-size:.92rem;color:rgba(255,255,255,.7);line-height:1.8;margin-bottom:1.5rem;max-width:560px;font-weight:400}
.btn-rose-outline{display:inline-block;background:transparent;border:1.5px solid rgba(255,255,255,.45);color:#fff;padding:.75rem 1.5rem;font-family:'Montserrat',sans-serif;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;border-radius:4px;text-decoration:none;transition:all .2s;margin-right:.5rem;margin-top:.25rem}
.btn-rose-outline:hover{background:rgba(255,255,255,.12);border-color:#fff}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .hero-section{padding:3.5rem 1.5rem 4rem}
  .hero-section::before,.hero-section::after{display:none}
  .why-inner{grid-template-columns:1fr;gap:2rem}
  .why-section{padding:4rem 1.5rem}
  .home-offers-inner{grid-template-columns:1fr;gap:2.5rem}
  .home-offers-section{padding:4rem 1.5rem}
  .home-country,.stat-cards-section{padding:4rem 1.5rem}
  .impact-strip{padding:2rem 1.5rem}
  .info-strip{padding:3rem 1.5rem}
  .impact-divider{display:none}
  .impact-item{padding:.75rem 1.25rem}
}
@media(max-width:640px){
  .hero-title{font-size:2.2rem}
  .home-offers-grid{grid-template-columns:1fr}
  .hero-btns{flex-direction:column}
  .btn-ink,.btn-bdr{text-align:center}
}

/* HELPLINE BAR — static inside home page */
.home-helpline-bar{background:var(--green-dark);padding:1.25rem 2rem 1rem}
.home-helpline-inner{max-width:1200px;margin:0 auto}
.home-helpline-label{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.55);display:block;margin-bottom:.65rem;font-weight:400}
.home-helpline-numbers{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-bottom:.65rem}
.hn-item{display:flex;align-items:center;gap:.4rem}
.hn-flag{font-size:.85rem;line-height:1}
.hn-tel{font-size:.72rem;color:rgba(255,255,255,.82);text-decoration:none;transition:color .15s;white-space:nowrap}
.hn-tel:hover{color:#fff}
.hn-tel strong{color:#fff;font-weight:400;margin-right:2px}
.home-helpline-note{font-size:.65rem;color:rgba(255,255,255,.38);letter-spacing:.02em}
.home-helpline-note strong{color:rgba(255,255,255,.6);font-weight:400}
.hn-link{background:none;border:none;color:rgba(29,158,117,.9);font-size:.65rem;cursor:pointer;font-family:'Montserrat',sans-serif;padding:0;text-decoration:underline;text-underline-offset:2px;transition:color .15s}
.hn-link:hover{color:#fff}

/* FIND HELP BUTTON SECTION */
.home-findhelp{background:var(--sage);padding:4rem 3rem;border-top:0.5px solid var(--sage-mid)}
.home-findhelp-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:4rem;align-items:center}
.hfh-eye{font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.75rem}
.hfh-title{font-family:'Inter',sans-serif;font-size:clamp(1.4rem,2.5vw,1.9rem);font-weight:400;color:var(--ink);line-height:1.2;margin-bottom:.75rem}
.hfh-sub{font-size:.95rem;color:var(--mid);line-height:1.8;font-weight:400}
.home-findhelp-right{display:flex;flex-direction:column;align-items:center;gap:.65rem;flex-shrink:0}
.hfh-btn{background:var(--green);color:#fff;border:none;padding:1.1rem 2.25rem;font-family:'Montserrat',sans-serif;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border-radius:4px;font-weight:400;transition:background .2s;white-space:nowrap}
.hfh-btn:hover{background:var(--green-dark)}
.hfh-note{font-size:.72rem;color:var(--soft);text-align:center}

@media(max-width:860px){
  .home-helpline-bar{padding:1.1rem 1.25rem .9rem}
  .home-helpline-numbers{gap:.4rem 1rem}
  .hn-tel{font-size:.68rem}
  .home-findhelp{padding:3rem 1.5rem}
  .home-findhelp-inner{grid-template-columns:1fr;gap:1.75rem}
  .home-findhelp-right{align-items:flex-start}
  .hfh-btn{width:100%}
}
@media(max-width:640px){
  .home-helpline-numbers{gap:.35rem .75rem}
  .hn-tel{font-size:.64rem}
}

/* READABLE TYPOGRAPHY — Pivotal inspired */
.gs-step-body{font-size:1.02rem!important;line-height:1.95!important}
.gs-rec-text{font-size:1rem!important;line-height:1.95!important}
.collab-body{font-size:1rem!important;line-height:1.95!important}
.why-body{font-size:1.02rem!important;line-height:1.95!important}
.hero-sub{font-size:1.1rem!important;line-height:1.88!important}
.rc-abstract{font-size:.95rem!important;line-height:1.88!important}
.res-body{font-size:.9rem!important;line-height:1.88!important}
.story-body p{font-size:1.02rem!important;line-height:1.95!important;margin-bottom:1.5rem!important}
.article-body p{font-size:1.02rem!important;line-height:1.95!important;margin-bottom:1.6rem!important}
.gs-acc-text p{font-size:1rem!important;line-height:1.9!important}

/* WHO WE ARE */
.who-mv-section{padding:2.5rem 0 1.5rem}
.who-mv-block{margin-bottom:2rem;padding-bottom:2rem;border-bottom:0.5px solid var(--border)}
.who-mv-eye{font-size:.6rem;letter-spacing:.25em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.85rem;font-weight:400}
.who-mv-text{font-size:1rem;line-height:1.95;color:var(--mid);margin-bottom:1rem;font-weight:400}
.who-mv-divider{display:flex;align-items:center;gap:1rem;margin:1.5rem 0 2rem}
.who-mv-divider-line{flex:1;height:0.5px;background:var(--border)}
.who-mv-divider-label{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--soft);white-space:nowrap}

/* GUIDANCE DROPDOWN */
.nav-dd-wrap{position:relative;display:inline-block}
.nav-dd-menu{display:none;position:absolute;top:calc(100% + 10px);right:0;background:var(--white);border:1px solid var(--border);border-radius:8px;padding:.4rem;min-width:250px;box-shadow:0 8px 32px rgba(0,0,0,.1);z-index:500;flex-direction:column}
.nav-dd-menu.open{display:flex}
.nav-dd-trigger{background:none;border:none;font-family:'Montserrat',sans-serif;font-size:.72rem;color:var(--mid);cursor:pointer;padding:0}
.nav-dd-trigger:hover,.nav-dd-trigger.active{color:var(--ink)}
.nav-dd-opt{display:flex;align-items:center;gap:.65rem;padding:.6rem .85rem;background:none;border:none;width:100%;text-align:left;font-family:'Montserrat',sans-serif;cursor:pointer;border-radius:5px;transition:background .15s}
.nav-dd-opt:hover{background:var(--green-light)}
.nav-dd-n{font-family:'Inter',sans-serif;font-size:.68rem;color:var(--green);min-width:18px;flex-shrink:0}
.nav-dd-lbl{font-size:.75rem;color:var(--ink);font-weight:400}

.slinks{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:.5rem}
.slink{display:inline-block;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green);text-decoration:none;padding:4px 0;border-bottom:1px solid rgba(29,158,117,.3);transition:border-color .15s}
.slink:hover{border-color:var(--green);color:var(--green-dark)}
.slink-pm{color:var(--soft);border-bottom-color:rgba(136,135,128,.3)}
.slink-pm:hover{color:var(--ink);border-bottom-color:var(--soft)}

/* WHO WE ARE - TEAM */
.who-compact{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0;border:0.5px solid var(--border);border-radius:6px;overflow:hidden;margin-bottom:2.5rem}
.who-compact-card{padding:1.5rem;border-right:0.5px solid var(--border);background:var(--white)}
.who-compact-card:last-child{border-right:none}
.who-compact-label{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.55rem}
.who-compact-text{font-size:.88rem;color:var(--mid);line-height:1.8;font-weight:400}
.who-team-heading{font-family:'Inter',sans-serif;font-size:1.5rem;font-weight:400;color:var(--ink);margin-bottom:1.75rem;margin-top:2.5rem}
.who-team-heading em{font-style:italic;color:var(--green-dark)}
.who-member{display:grid;grid-template-columns:100px 1fr;gap:1.75rem;padding:1.75rem 0;border-bottom:0.5px solid var(--border);align-items:start}
.who-member:last-child{border-bottom:0.5px solid var(--border)}
.who-photo{width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--green-light);display:block}
.who-name{font-family:'Inter',sans-serif;font-size:1.1rem;font-weight:400;color:var(--ink);line-height:1.2;margin-bottom:.15rem}
.who-role{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.1rem}
.who-loc{font-size:.7rem;color:var(--soft);display:block;margin-bottom:.7rem}
.who-bio{font-size:.9rem;color:var(--mid);line-height:1.85;font-weight:400}
.who-exp{margin-top:.75rem;padding-top:.75rem;border-top:0.5px solid var(--border)}
.who-exp-label{font-size:.55rem;letter-spacing:.15em;text-transform:uppercase;color:var(--soft);display:block;margin-bottom:.45rem}
.who-exp-row{padding-left:.65rem;border-left:2px solid var(--green-light);margin-bottom:.55rem}
.who-exp-title{font-size:.78rem;font-weight:400;color:var(--ink);display:block}
.who-exp-links{margin-top:.2rem;display:flex;flex-wrap:wrap;gap:.4rem}
.who-exp-link{font-size:.68rem;color:var(--green);text-decoration:none;border-bottom:1px solid rgba(29,158,117,.25);padding-bottom:1px}
.who-exp-link:hover{color:var(--green-dark)}
.who-note-rule{display:flex;align-items:center;gap:.75rem;margin:2rem 0 1.5rem}
.who-note-rule span{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--soft);white-space:nowrap}
.who-note-rule::before,.who-note-rule::after{content:'';flex:1;height:0.5px;background:var(--border)}
@media(max-width:640px){
  .who-compact{grid-template-columns:1fr}
  .who-compact-card{border-right:none;border-bottom:0.5px solid var(--border)}
  .who-compact-card:last-child{border-bottom:none}
  .who-member{grid-template-columns:70px 1fr;gap:1rem}
  .who-photo{width:60px;height:60px}
}

/* WHO WE ARE TEAM */
.who-team-wrap{margin:2.5rem 0}
.who-team-heading{font-family:'Inter',sans-serif;font-size:1.5rem;font-weight:400;color:var(--ink);margin-bottom:1.75rem}
.who-team-heading em{font-style:italic;color:var(--green-dark)}
.who-member{display:grid;grid-template-columns:100px 1fr;gap:1.75rem;padding:1.75rem 0;border-bottom:0.5px solid var(--border)}
.who-member:last-child{border-bottom:none}
.who-photo-wrap{flex-shrink:0}
.who-photo{width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid var(--green-light);display:block}
.who-initial-circle{width:80px;height:80px;border-radius:50%;background:var(--green-light);border:2px solid var(--green);display:flex;align-items:center;justify-content:center;font-family:'Inter',sans-serif;font-size:2rem;font-style:italic;color:var(--green)}
.who-name{font-family:'Inter',sans-serif;font-size:1.1rem;font-weight:400;color:var(--ink);margin-bottom:.15rem}
.who-role{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.1rem}
.who-loc{font-size:.7rem;color:var(--soft);display:block;margin-bottom:.7rem}
.who-bio{font-size:.9rem;color:var(--mid);line-height:1.85;font-weight:400}
.who-exp{margin-top:.75rem;padding-top:.75rem;border-top:0.5px solid var(--border)}
.who-exp-label{font-size:.55rem;letter-spacing:.15em;text-transform:uppercase;color:var(--soft);display:block;margin-bottom:.45rem}
.who-exp-row{padding-left:.65rem;border-left:2px solid var(--green-light);margin-bottom:.55rem}
.who-exp-title{font-size:.78rem;font-weight:400;color:var(--ink);display:block}
.who-exp-links{margin-top:.2rem;display:flex;flex-wrap:wrap;gap:.4rem}
.who-exp-link{font-size:.68rem;color:var(--green);text-decoration:none;border-bottom:1px solid rgba(29,158,117,.25);padding-bottom:1px}
.who-exp-link:hover{color:var(--green-dark)}
.who-note-rule{display:flex;align-items:center;gap:.75rem;margin:2rem 0 1.5rem}
.who-note-rule span{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--soft);white-space:nowrap}
.who-note-rule::before,.who-note-rule::after{content:'';flex:1;height:0.5px;background:var(--border)}
@media(max-width:600px){
  .who-member{grid-template-columns:70px 1fr;gap:1rem}
  .who-photo,.who-initial-circle{width:60px;height:60px}
  .who-initial-circle{font-size:1.5rem}
}

.who-compact{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0;border:0.5px solid var(--border);border-radius:6px;overflow:hidden;background:var(--white)}
.who-compact-card{padding:1.5rem;border-right:0.5px solid var(--border)}
.who-compact-card:last-child{border-right:none}
.who-compact-label{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--green);display:block;margin-bottom:.55rem}
.who-compact-text{font-size:.88rem;color:var(--mid);line-height:1.8;font-weight:400}
@media(max-width:600px){
  .who-compact{grid-template-columns:1fr}
  .who-compact-card{border-right:none;border-bottom:0.5px solid var(--border)}
  .who-compact-card:last-child{border-bottom:none}
}
</style>
