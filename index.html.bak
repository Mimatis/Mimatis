        <button class="nav-dd-opt" onclick="showPage('support');gsOpenSub('words');closeSupportDD()"><span class="nav-dd-n">03</span><span class="nav-dd-lbl">What to say &amp; what not to</span></button>
        <button class="nav-dd-opt" onclick="showPage('support');gsOpenSub('info');closeSupportDD()"><span class="nav-dd-n">04</span><span class="nav-dd-lbl">Information cards in your language</span></button>
        <button class="nav-dd-opt" onclick="showPage('support');gsOpenSub('recovery');closeSupportDD()"><span class="nav-dd-n">05</span><span class="nav-dd-lbl">Your body after loss</span></button>
        <button class="nav-dd-opt" onclick="showPage('support');gsOpenSub('partners');closeSupportDD()"><span class="nav-dd-n">06</span><span class="nav-dd-lbl">For partners &amp; fathers</span></button>
