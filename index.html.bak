  {num:'03',sit:'Wider circle',title:'Telling acquaintances or a group',note:'This shorter version works well for a wider group.',text:'I wanted to share some difficult news with you.\n\nOur baby was born sleeping, and our family is grieving this profound loss. We are taking time away to be together and to heal, and we ask for your understanding and privacy during this period.\n\nIf you were expecting to hear from us, please know that we will be in touch again when we are ready.\n\n[Your name]'},
  {num:'04',sit:'Social media',title:'Sharing publicly, on your own terms',note:"You don't have to share publicly. This keeps it on your terms.",text:'Our baby [name] was born sleeping on [date].\n\nWe are sharing this because [he/she/they] existed, and [his/her/their] life mattered deeply to us.\n\nWe are not looking for advice, and we may not respond to messages for a while. But we are grateful to have people around us who care.\n\nThank you for holding us gently.'},
  {num:'05',sit:'Miscarriage',title:'When the loss was earlier in pregnancy',note:'Miscarriage is often suffered in silence. This breaks it gently.',text:'I wanted to let you know that I have recently had a miscarriage.\n\nIt has been a painful and difficult time. I know that pregnancy loss is not always easy to talk about, but it has affected me deeply and I felt it was important to be honest with you.\n\nI am not looking for anything specific — just for you to know, and to be patient with me.\n\nThank you for listening.\n\n[Your name]'},
  {num:'06',sit:'Asking for space',title:'When messages become overwhelming',note:'Kind but clear. Sets a boundary without requiring explanation.',text:'Thank you for reaching out. It means a great deal to know you are thinking of us.\n\nWe are not able to respond to messages right now, and we ask that you respect our need for quiet and privacy. We are not ready for visits, calls, or gatherings.\n\nWhen we are ready to reconnect, we will reach out. Until then, please know that your kindness is felt, even in our silence.\n\n[Your name]'},
  {num:'07',sit:'Religious or community group',title:'Informing a faith or community group',note:'Adjust to reflect your own faith tradition.',text:"Dear [Leader's name / Community],\n\nI am writing to share that our family has experienced the loss of our baby [name], who was born still on [date].\n\nWe are grateful for the love and support of this community, and we ask for your prayers and patience as we grieve. We may be absent from gatherings for some time.\n\nWith gratitude,\n[Your name]"},
  {num:'08',sit:'Partner or co-parent',title:'Writing together, as parents',note:'Written from both parents. Acknowledges that grief moves differently for each person.',text:'We are writing together to share that our baby [name] was born sleeping on [date].\n\nWe are heartbroken, and we are holding each other through this. Grief moves differently for each of us, and we ask for your understanding if we reach out at different times or in different ways.\n\nYour love and care mean everything to us.\n\n[Your names]'},
  {num:'09',sit:'Healthcare provider',title:'Requesting support or a referral',note:'You are entitled to ask your GP, midwife, or hospital team for specialist bereavement support.',text:'Dear [Doctor / Midwife / GP],\n\nI am writing to request support following the loss of my baby [name], who was born still on [date].\n\nI am finding this period very difficult and would be grateful for a referral to a specialist bereavement counsellor or a support service for parents who have experienced pregnancy or infant loss.\n\nThank you,\n[Your name]'}
];
var gsAL=document.getElementById('gs-acc-list');
gsLetters.forEach(function(l,i){
  var id='gsacc'+i;
  var el=document.createElement('div');el.className='gs-acc';el.id=id;
  el.innerHTML='<button class="gs-acc-header" onclick="gsToggleAcc(\''+id+'\')">'
    +'<div class="gs-acc-left"><span class="gs-acc-num">'+l.num+'</span><div><span class="gs-acc-sit">'+l.sit+'</span><span class="gs-acc-title">'+l.title+'</span></div></div>'
    +'<span class="gs-acc-chev">&#9660;</span></button>'
    +'<div class="gs-acc-body"><div class="gs-acc-text">'+l.text+'</div>'
    +'<span class="gs-acc-note-lbl">Note</span><div class="gs-acc-note">'+l.note+'</div>'
    +'<button class="gs-copy-btn" onclick="gsCopyLetter('+i+',this)">Copy letter</button></div>';
  gsAL.appendChild(el);
});
function gsToggleAcc(id){var el=document.getElementById(id);var was=el.classList.contains('open');document.querySelectorAll('.gs-acc.open').forEach(function(x){x.classList.remove('open');});if(!was)el.classList.add('open');}
function gsCopyLetter(i,btn){navigator.clipboard.writeText(gsLetters[i].text).then(function(){btn.textContent='Copied!';setTimeout(function(){btn.textContent='Copy letter';},2500);});}

// Build what to say cards
var gsNoSay=[
  {q:'At least you know you can get pregnant.',why:'This minimises the loss of this specific baby. The parent lost their child — not a pregnancy in the abstract.',alt:'I am so sorry. This baby mattered so much.'},
  {q:'Everything happens for a reason.',why:'There is no reason that makes the loss of a baby acceptable. This implies the loss was somehow necessary.',alt:'I do not have any words. I am just so sorry.'},
  {q:'At least it was early.',why:'For the parent, it was always a real baby. This phrase can make parents feel their grief is not valid.',alt:'Your loss is real. Your grief is valid. I am here.'},
  {q:'You can always try again.',why:'Another baby cannot replace this baby. This moves the conversation away from the loss before the parent is ready.',alt:'I am here for you right now.'},
  {q:'I know how you feel.',why:'Every grief is unique. Saying you understand can feel dismissive — as if the specific pain is being compared.',alt:'I cannot imagine what you are going through. I am here.'},
  {q:"They're in a better place.",why:'The parent wanted their baby here, with them. This can feel like it dismisses the enormity of what has been lost.',alt:'I am holding you in my thoughts.'},
  {q:'You should be over it by now.',why:'Grief has no timeline. The loss of a baby can be felt for the rest of a life — and that is entirely normal.',alt:'Grief takes as long as it takes. I am still here.'}
];
var gsYesSay=[
  {q:"I'm so sorry. Their name will always matter.",why:"Using the baby's name — if shared — is one of the most meaningful things you can do.",alt:null},
  {q:"You don't have to say anything. I'm just here.",why:'Bereaved parents are often exhausted by managing others emotions. Removing that pressure is a genuine act of care.',alt:null},
  {q:"I'm thinking of you. No need to reply.",why:'A message that requires no response lets the parent know they are loved without adding to their burden.',alt:null},
  {q:"I don't have the right words. But I didn't want to say nothing.",why:'Honesty about not knowing what to say is far better than silence.',alt:null},
  {q:'Can I bring you food or take care of something practical?',why:'Specific offers are far more helpful than general ones. Grief is exhausting and basic tasks can feel impossible.',alt:null},
  {q:"I remembered today is the anniversary. I'm thinking of you.",why:'Remembering key dates weeks or months later is one of the most powerful things a friend can do.',alt:null}
];
function gsBuildSayCards(data,cid,type){
  var wrap=document.getElementById(cid);if(!wrap)return;
  data.forEach(function(item,i){
    var id=type+'gs'+i;
    var el=document.createElement('div');el.className='gs-say-card';el.id=id;
    var altHtml=item.alt?'<span class="gs-say-inlbl">Try instead</span><div class="gs-say-alt">'+item.alt+'</div>':'';
    el.innerHTML='<button class="gs-say-hdr" onclick="gsToggleSay(\''+id+'\')"><p class="gs-say-q '+(type==='no'?'nq':'yq')+'">'+(type==='no'?'&ldquo;':'✓ ')+item.q+(type==='no'?'&rdquo;':'')+'</p><span class="gs-say-chev">&#9660;</span></button><div class="gs-say-body"><p class="gs-say-why">'+item.why+'</p>'+altHtml+'</div>';
    wrap.appendChild(el);
  });
}
function gsToggleSay(id){var el=document.getElementById(id);var was=el.classList.contains('open');document.querySelectorAll('.gs-say-card.open').forEach(function(x){x.classList.remove('open');});if(!was)el.classList.add('open');}
gsBuildSayCards(gsNoSay,'gs-no-say','no');
gsBuildSayCards(gsYesSay,'gs-yes-say','yes');

// ── NEW GUIDANCE SUBVIEWS ──
document.getElementById('gcard-recovery').addEventListener('click', function(){ gsOpenSub('recovery'); });
document.getElementById('gcard-partners').addEventListener('click', function(){ gsOpenSub('partners'); });
document.getElementById('gs-back-recovery').addEventListener('click', function(){ gsOpenSub('landing'); });
document.getElementById('gs-back-partners').addEventListener('click', function(){ gsOpenSub('landing'); });

// ── PHYSICAL RECOVERY CONTENT ──
var recoveryItems = [
  {
    n:'01',
    title:'Your breasts and milk',
    body:[
      'Your body will produce milk in the days following birth, driven by the natural hormonal shift after delivery. This happens regardless of whether your baby survived — and it can feel profoundly cruel. You are not alone in finding this one of the most physically and emotionally difficult parts of the days after loss.',
      'Your breasts may become very full, tight, and tender. This is called engorgement and it is temporary, though it can last several days. There are things that can help: applying a cool cloth or cold compress for relief, expressing just enough milk by hand to ease the pressure — not enough to stimulate further production — and wearing a supportive, well-fitting bra.',
      'Warm showers can help milk release naturally and ease discomfort. Speak to your midwife or GP about medication that can help suppress milk production if you would like this option — it is available and completely valid to ask for it.',
      'If you were expressing milk for your baby in a neonatal unit and you wish to continue, some hospitals offer the option of donating to a milk bank. This is a personal choice. There is no right answer.'
    ],
    note:'Talk to your midwife about all available options. You do not need to manage this alone.'
  },
  {
    n:'02',
    title:'Bleeding and physical recovery after birth',
    body:[
      'After birth — whether vaginal or by caesarean section — your body will shed the lining of the womb over the following weeks. This bleeding, known as lochia, is normal and expected. It will typically be heaviest in the first few days, gradually lightening and changing colour from red to pink to brown over two to six weeks.',
      'Use maternity pads rather than tampons during this time, as your body needs to heal internally. If you are passing large clots, bleeding very heavily, or are concerned about anything you are experiencing, contact your midwife or GP. Trust your instincts — you know your body.',
      'Abdominal cramping in the first days after birth is also normal. Your womb is contracting back to its usual size and this can feel like strong period pains. Pain relief such as ibuprofen or paracetamol can help — always follow the recommended dosage and check with your healthcare provider if you are unsure.'
    ],
    note:null
  },
  {
    n:'03',
    title:'Healing after a vaginal birth or stitches',
    body:[
      'If you experienced a tear or episiotomy during birth, you may have stitches that need time to heal. Even though caring for yourself physically may feel unimportant right now, keeping the area clean and dry will help prevent infection and support healing.',
      'Bathing gently in clean, warm water each day is helpful. Lying on your side rather than sitting for extended periods can reduce discomfort in the first days. Try to avoid anything that puts pressure on the area while you heal.',
      'If you have any concerns about your stitches — including unusual pain, swelling, or any signs of infection such as increased redness or discharge — contact your midwife or GP. You are still in your postnatal recovery period and you are entitled to care.'
    ],
    note:null
  },
  {
    n:'04',
    title:'Recovering from a caesarean section',
    body:[
      'If your baby was born by caesarean section, your recovery will take longer and you will need more support at home in the weeks that follow. You may have been in hospital for several days, and returning home without your baby is a pain that no medical guidance can fully address — but your body still needs time and care.',
      'Pain relief will be important in the first days and weeks. Move gently and as soon as you feel able — walking, even slowly, helps the body recover. Avoid lifting anything heavier than your baby would have been for the first six weeks. Driving is usually not advised for around six weeks — check with your doctor.',
      'Keep your wound clean and dry. Gently washing and drying the area each day helps prevent infection. If you notice redness, swelling, discharge, or increased pain around the wound site, contact your GP promptly.'
    ],
    note:'Your midwife team will continue to visit you at home after discharge. Do not hesitate to ask them about anything, physical or emotional.'
  },
  {
    n:'05',
    title:'Your pelvic floor',
    body:[
      'Giving birth, regardless of the outcome, weakens the pelvic floor muscles. You may notice less control than usual, or you may feel very little sensation at all when you first try to engage these muscles. This is completely normal and will improve over time.',
      'Gentle pelvic floor exercises — squeezing and holding the internal muscles as if stopping the flow of urine — can begin whenever you feel ready. There is no pressure or timeline. If bladder control has not improved after three months, speak to your GP about a referral to a physiotherapist who specialises in postnatal recovery.',
      'Be patient with your body. It has been through something enormous. Recovery takes time — physically and in every other way.'
    ],
    note:null
  },
  {
    n:'06',
    title:'Sleep, appetite, and the physical effects of grief',
    body:[
      'Grief is not only emotional. It lives in the body too. In the weeks and months after loss, many parents experience disrupted sleep, changes in appetite, physical exhaustion, headaches, and a lowered immune system. These are normal responses to profound stress and loss — not signs that something is wrong with you.',
      'Try to eat something, even when appetite has gone. Not because food will fix anything, but because your body is healing from birth while also carrying grief, and it needs fuel. Simple, easy foods — whatever you can manage — are better than nothing.',
      'Sleep when you can. Accept help when it is offered. Reduce demands on yourself wherever possible. The months after a loss are not the time to function at full capacity, and no one around you should expect that of you.',
      'If you are finding that physical symptoms of grief are significantly affecting your daily life after several months — persistent insomnia, inability to eat, or physical symptoms you cannot explain — speak to your GP. They can help, and you deserve support.'
    ],
    note:'Between 30 and 60% of bereaved parents meet the clinical criteria for PTSD. If you are struggling, please ask for help. You are not being dramatic. You are not weak. You are human.'
  },
  {
    n:'07',
    title:'Your first period after loss',
    body:[
      'Your first period after a birth typically returns within four to eight weeks, though this varies. It can sometimes be difficult to distinguish from the ongoing lochia in the first weeks.',
      'Many parents find their first period after loss unexpectedly hard — emotionally as well as physically. It can feel like another loss, another reminder that time is moving forward when part of you feels it should have stopped. This is a completely understandable response.',
      'Your cycle may not return to its usual pattern straight away. If you have concerns about your cycle or are planning another pregnancy, your GP or a specialist can advise you on what to expect and when it is safe to consider trying again.'
    ],
    note:null
  },
  {
    n:'08',
    title:'When to seek medical help',
    body:[
      'You are still a postnatal patient. You have the right to full postnatal care from your midwife team and GP regardless of what happened to your baby. Do not minimise your physical symptoms or assume you are not entitled to support.',
      'Contact your midwife or GP promptly if you experience: very heavy bleeding or large clots, signs of infection in a wound or the vaginal area, severe or worsening pain, a high temperature, difficulty breathing, or any symptom that feels wrong to you.',
      'Your instincts matter. If something does not feel right, get it checked. You have been through one of the most physically and emotionally demanding experiences a person can face — your body deserves the same care it would receive after any other birth.'
    ],
    note:null
  }
];

var recList = document.getElementById('gs-recovery-list');
if (recList) {
  recoveryItems.forEach(function(item, i) {
    var id = 'rec' + i;
    var el = document.createElement('div');
    el.className = 'gs-rec-item';
    el.id = id;
    var noteHtml = item.note ? '<div class="gs-rec-note"><strong>Note: </strong>' + item.note + '</div>' : '';
    var bodyHtml = item.body.map(function(p){ return '<p class="gs-rec-text">' + p + '</p>'; }).join('');
    el.innerHTML = '<button class="gs-rec-header" onclick="gsToggleRec(\''+id+'\')"><div class="gs-rec-left"><span class="gs-rec-num">'+item.n+'</span><span class="gs-rec-title">'+item.title+'</span></div><span class="gs-rec-chev">&#9660;</span></button><div class="gs-rec-body">'+bodyHtml+noteHtml+'</div>';
    recList.appendChild(el);
  });
}
function gsToggleRec(id){
  var el=document.getElementById(id);
  var was=el.classList.contains('open');
  document.querySelectorAll('.gs-rec-item.open').forEach(function(x){x.classList.remove('open');});
  if(!was)el.classList.add('open');
}

// ── FOR PARTNERS & FATHERS CONTENT ──
var partnersSteps = [
  {n:'01', t:'Your grief is real — and it may look different', b:'Partners and fathers grieve as deeply as mothers after pregnancy or infant loss. But grief rarely looks the same between two people, and the way men and partners often grieve — quietly, practically, without talking — can make it feel invisible, even to themselves. Your grief is not less because it is quieter. It is not less because you went back to work. It is not less because you are holding someone else together. It is real, and it deserves space.'},
  {n:'02', t:'You may feel you have to be strong', b:'The pressure to be the steady one — to manage the practical things, to keep going, to hold your partner — is something almost every father and partner describes. There is nothing wrong with being strong for someone you love. But strength cannot mean silence forever. Find at least one place where you do not have to hold it — whether that is with a trusted friend, a counsellor, or on your own in the car on the way home from work. You need somewhere to put it.'},
  {n:'03', t:'Grief can look like anger, distraction, or numbness', b:'Not all grief looks like crying. For many men and partners, grief surfaces as irritability, an inability to concentrate, throwing themselves into work, losing interest in things they used to care about, or a persistent feeling of numbness. These are all forms of grief. If you recognise yourself in any of these and it has been going on for weeks or months, it may be worth speaking to a GP or counsellor who understands bereavement.'},
  {n:'04', t:'You may grieve at a different pace than your partner', b:'One of the most common — and most painful — experiences for couples after a loss is discovering that they grieve differently and at different speeds. One of you may want to talk about it constantly; the other may need silence. One may seem to be moving forward while the other is still in the acute phase of grief. Neither of you is wrong. This difference is not a sign that you loved your baby less. But it can create distance between you if it is not acknowledged. Tell each other, as honestly as you can, what you need — and ask what your partner needs in return.'},
  {n:'05', t:'You are also a bereaved parent', b:'Much of the medical and support system — the midwife visits, the counselling referrals, the bereavement leaflets — is directed at mothers. This can leave fathers and partners feeling like a secondary figure in a loss that belongs equally to them. You are not secondary. You lost your child too. You are entitled to bereavement leave, to grief counselling, to support. If your employer or GP does not offer it readily, ask for it directly.'},
  {n:'06', t:'Returning to work', b:'Many partners return to work within days of a loss — sometimes because there is no formal bereavement leave provision, sometimes because work feels safer than being at home. If you are at work and struggling, you do not have to explain the details to everyone. A simple statement — "I have had a bereavement and I am not fully myself right now" — is enough. You are entitled to compassion from your workplace, and most people will offer it if given the chance.'},
  {n:'07', t:'Letter templates are available for you too', b:'The letter templates in the Finding the Right Words section of this site were written with all bereaved parents in mind — including partners and fathers. You may find them helpful when notifying your employer, your wider circle, or when you simply cannot find the words yourself.'},
  {n:'08', t:'Where to find support', b:'MIMATIS lists verified support resources across 29 countries in the Find Help section — many of which offer support specifically for fathers and partners. If you find it difficult to seek help for yourself, consider framing it as something you are doing for your relationship or your family. The strongest thing a bereaved parent can do is ask for support.'}
];

var partnersList = document.getElementById('gs-partners-list');
if (partnersList) {
  partnersSteps.forEach(function(s){
    var d = document.createElement('div');
    d.className = 'gs-step';
    d.innerHTML = '<div class="gs-step-left"><span class="gs-step-label">—</span><span class="gs-step-n">'+s.n+'</span></div><div><h3 class="gs-step-title">'+s.t+'</h3><p class="gs-step-body">'+s.b+'</p></div>';
    partnersList.appendChild(d);
  });
}



var noSay=[
  {q:'At least you know you can get pregnant.',why:'This minimises the loss of this specific baby. The parent did not lose a pregnancy in the abstract they lost their child. Knowing they can conceive again does not ease that grief.',alt:'I am so sorry. This baby mattered so much.'},
  {q:'Everything happens for a reason.',why:'There is no reason that makes the loss of a baby acceptable. This phrase implies the loss was somehow necessary or deserved. It is rarely comforting, however kindly meant.',alt:'I do not have any words. I am just so sorry.'},
  {q:'At least it was early. At least it was not a real baby yet.',why:'For the parent, it was always a real baby. The depth of love and loss is not determined by gestational age. This phrase can make parents feel their grief is not valid.',alt:'Your loss is real. Your grief is valid. I am here.'},
  {q:'You can always try again.',why:'Another baby cannot replace this baby. And for many parents, trying again is complicated, frightening, or not possible. This moves the conversation away from the loss before the parent is ready.',alt:'I am here for you right now. That is all that matters.'},
  {q:'I know how you feel. I understand.',why:'Even if you have experienced loss yourself, every grief is unique. Saying you understand can feel dismissive as if the specific pain is being compared or minimised.',alt:'I cannot imagine what you are going through. I am here.'},
  {q:'They are in a better place.',why:'The parent wanted their baby here, with them. Whatever your beliefs, this phrase can feel like it dismisses the reality and enormity of what has been lost.',alt:'I am holding you in my thoughts. Take all the time you need.'},
  {q:'You should be over it by now.',why:'Grief has no timeline. This is one of the most painful things a bereaved parent can hear. The loss of a baby can be felt for the rest of a life and that is entirely normal.',alt:'Grief takes as long as it takes. I am still here.'}
];
var yesSay=[
  {q:'I am so sorry. Their name will always matter.',why:"Using the baby's name if the parents have shared it is one of the most meaningful things you can do. It acknowledges that their child existed and is remembered.",alt:null},
  {q:'You do not have to say anything. I am just here.',why:'Bereaved parents are often exhausted by having to explain, manage others emotions, or perform gratitude. Removing that pressure is a genuine act of care.',alt:null},
  {q:'I am thinking of you. No need to reply.',why:'A message that requires no response lets the parent know they are loved without adding another thing to manage. Especially helpful in the first weeks.',alt:null},
  {q:'I do not have the right words. But I did not want to say nothing.',why:'Honesty about not knowing what to say is far better than silence. Most parents would rather you said something imperfect than disappeared.',alt:null},
  {q:'Can I bring you food, sit with you, or take care of something practical?',why:'Specific, practical offers are far more helpful than general ones. Grief is exhausting and basic tasks can feel impossible. Ask for something you can actually do.',alt:null},
  {q:'I remembered today is the due date or the anniversary. I am thinking of you.',why:'Remembering key dates weeks or months later is one of the most powerful things a friend can do. Most people disappear after the first week. Showing up later matters enormously.',alt:null}
];
function buildWCards(data,cid,type){
  var wrap=document.getElementById(cid);
  if(!wrap)return;
  data.forEach(function(item,i){
    var id=type+'w'+i;
    var el=document.createElement('div');
    el.className='wcard';el.id=id;
    var altHtml=item.alt?'<span class="wcard-inlabel">Try instead</span><p class="wcard-alt">'+item.alt+'</p>':'';
    el.innerHTML='<div class="wcard-header" onclick="toggleW(\''+id+'\')"><p class="wcard-quote '+(type==='no'?'nq':'yq')+'">'+(type==='no'?'&ldquo;':'&#10003;&ensp;')+item.q+(type==='no'?'&rdquo;':'')+'</p><i class="ti ti-chevron-down wcard-chev" aria-hidden="true"></i></div><div class="wcard-body"><p class="wcard-why">'+item.why+'</p>'+altHtml+'</div>';
    wrap.appendChild(el);
  });
}
function toggleW(id){var el=document.getElementById(id);var was=el.classList.contains('open');document.querySelectorAll('.wcard.open').forEach(function(x){x.classList.remove('open');});if(!was)el.classList.add('open');}
buildWCards(noSay,'no-cards','no');
buildWCards(yesSay,'yes-cards','yes');


// ── JOURNAL NAVIGATION (single authoritative version) ──
function openJournalArticle(key) {
  showPage('journal');
  setTimeout(function() {
    document.querySelectorAll('#pg-journal .gs-sub-view').forEach(function(v){
      v.classList.remove('active');
    });
    var target = document.getElementById('journal-' + key);
    if(target) {
      target.classList.add('active');
    }
    window.scrollTo(0, 0);
  }, 60);
}

function filterJournal(pillar, btn) {
  document.querySelectorAll('.jtab').forEach(function(t){t.classList.remove('active');});
  btn.classList.add('active');
  document.querySelectorAll('[data-pillar]').forEach(function(card){
    card.style.display = (pillar==='all'||card.dataset.pillar===pillar) ? '' : 'none';
  });
}

// ── NEWSLETTER SIGNUP (Supabase) ──
function nlSubscribe(){
  var inp=document.getElementById('nl-email');
  var btn=document.getElementById('nl-submit');
  var msg=document.getElementById('nl-msg');
  var v=(inp&&inp.value?inp.value:'').trim().toLowerCase();
  if(msg){msg.style.display='none';msg.textContent='';}
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)){
    if(msg){msg.textContent='Please enter a valid email address.';msg.style.display='block';}
    return;
  }
  if(btn){btn.disabled=true;btn.textContent='One moment\u2026';}
  getSB().from('newsletter_subscribers').insert([{email:v}]).then(function(r){
    if(r.error && r.error.code!=='23505'){
      if(btn){btn.disabled=false;btn.textContent='Subscribe';}
      if(msg){msg.textContent='Something went wrong \u2014 please try again in a moment.';msg.style.display='block';}
      return;
    }
    var w=document.getElementById('nl-form-wrap');
    var ok=document.getElementById('nl-success');
    if(w)w.style.display='none';
    if(ok)ok.style.display='block';
  });
}
(function(){
  var b=document.getElementById('nl-submit');
  var i=document.getElementById('nl-email');
  if(b)b.addEventListener('click',nlSubscribe);
  if(i)i.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();nlSubscribe();}});
})();

// ── SUPPORT DROPDOWN ──
function toggleSupportDD() {
  var menu = document.getElementById('nav-dd-menu');
  if(menu) menu.classList.toggle('open');
}
function closeSupportDD() {
  var menu = document.getElementById('nav-dd-menu');
  if(menu) menu.classList.remove('open');
}
// Close on outside click
document.addEventListener('click', function(e) {
  var wrap = document.getElementById('nav-dd-support');
  if(wrap && !wrap.contains(e.target)) closeSupportDD();
});
</script>
</body>
</html>