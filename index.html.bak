<!-- ═══ HOME ═══ -->
<div id="pg-home" class="pg active" aria-label="MIMATIS — Bereavement support for every parent">

  <!-- HERO -->
  <div class="hero-section">
    <div class="hero-inner">
      <span class="hero-eyebrow">Bereavement care &middot; Worldwide</span>
      <h1 class="hero-title">For every parent<br>who has <em>lost a baby.</em></h1>
      <p class="hero-sub">A digital platform reaching bereaved parents across Europe and beyond &mdash; removing the language and geographic barriers that prevent families from finding care after loss.</p>
      <div class="hero-btns">
        <button class="btn-ink" onclick="showPage('help')">Find support in your country</button>
        <button class="btn-bdr" onclick="showPage('garden')">Memorial garden</button>
        <button class="btn-bdr" onclick="showPage('support')">Guidance &amp; support</button>
      </div>
    </div>
  </div>

  <!-- IMPACT NUMBERS -->
  <div class="impact-strip">
    <div class="impact-inner">
      <div class="impact-item"><span class="impact-n">29</span><span class="impact-l">Countries with<br>verified support</span></div>
      <div class="impact-divider"></div>
      <div class="impact-item"><span class="impact-n">23</span><span class="impact-l">Peer-reviewed<br>research studies</span></div>
      <div class="impact-divider"></div>
      <div class="impact-item"><span class="impact-n">44</span><span class="impact-l">Pregnancy losses<br>every minute</span></div>
      <div class="impact-divider"></div>
      <div class="impact-item"><span class="impact-n">10+</span><span class="impact-l">Languages in our<br>information cards</span></div>
    </div>
  </div>

  <!-- HELPLINE BAR — static, inside home page only -->
  <div class="home-helpline-bar">
    <div class="home-helpline-inner">
      <span class="home-helpline-label">Crisis helplines &mdash; if you need to talk right now</span>
      <div class="home-helpline-numbers">
        <div class="hn-item"><span class="hn-flag">&#127468;&#127463;</span><a class="hn-tel" href="tel:08081643332"><strong>Sands UK</strong> 0808 164 3332</a></div>
        <div class="hn-item"><span class="hn-flag">&#127462;&#127482;</span><a class="hn-tel" href="tel:1300308307"><strong>Red Nose AU</strong> 1300 308 307</a></div>
        <div class="hn-item"><span class="hn-flag">&#127482;&#127480;</span><a class="hn-tel" href="tel:18009444773"><strong>PSI US</strong> 1-800-944-4773</a></div>
        <div class="hn-item"><span class="hn-flag">&#127470;&#127466;</span><a class="hn-tel" href="tel:1800727727"><strong>IE</strong> 1800 727 727</a></div>
        <div class="hn-item"><span class="hn-flag">&#127467;&#127479;</span><a class="hn-tel" href="tel:0140450636"><strong>FR</strong> 01 40 45 06 36</a></div>
        <div class="hn-item"><span class="hn-flag">&#127465;&#127466;</span><a class="hn-tel" href="tel:08001110111"><strong>DE</strong> 0800 111 0 111</a></div>
        <div class="hn-item"><span class="hn-flag">&#127475;&#127473;</span><a class="hn-tel" href="tel:08000113"><strong>NL</strong> 0800 0113</a></div>
        <div class="hn-item"><span class="hn-flag">&#127463;&#127466;</span><a class="hn-tel" href="tel:106"><strong>BE</strong> 106</a></div>
        <div class="hn-item"><span class="hn-flag">&#127480;&#127466;</span><a class="hn-tel" href="tel:90101"><strong>SE</strong> 90101</a></div>
        <div class="hn-item"><span class="hn-flag">&#127477;&#127473;</span><a class="hn-tel" href="tel:116123"><strong>PL</strong> 116 123</a></div>
        <div class="hn-item"><span class="hn-flag">&#127466;&#127480;</span><a class="hn-tel" href="tel:717003717"><strong>ES</strong> 717 003 717</a></div>
        <div class="hn-item"><span class="hn-flag">&#127470;&#127481;</span><a class="hn-tel" href="tel:0223272327"><strong>IT</strong> 02 2327 2327</a></div>
      </div>
      <p class="home-helpline-note">All other countries &mdash; <button class="hn-link" onclick="showPage('help')">Find Help</button> &middot; EU emergency: <strong>112</strong></p>
    </div>
  </div>

  <!-- WHY MIMATIS EXISTS -->
  <div class="why-section">
    <div class="why-inner">
      <div class="why-left">
        <span class="why-eye">Why MIMATIS exists</span>
        <h2 class="why-title">The parent who finds nothing<br>at <em>3 in the morning.</em></h2>
      </div>
      <div class="why-right">
        <p class="why-body">A parent who speaks the language of their country, who knows their health system, who has a supportive midwife &mdash; that parent has a chance of finding support after loss.</p>
        <p class="why-body">A parent who moved from Lithuania to the Netherlands for work, who does not speak Dutch, who does not know the term &ldquo;bereavement midwife&rdquo; exists, who is searching at 3am for someone who can help &mdash; that parent finds nothing.</p>
        <p class="why-body">Language, geography, and mobility are among the most overlooked determinants of bereavement care. As Europe&rsquo;s population becomes increasingly mobile &mdash; with millions of parents raising families in countries that are not their own &mdash; the assumption that local, monolingual resources are sufficient is no longer valid.</p>
        <p class="why-body">MIMATIS was built to solve this. A digital-first platform with no geographic restriction &mdash; available to every bereaved parent, wherever they are, in any language, at any hour.</p>
        <button class="why-cta" onclick="showPage('story')">Read our story &rarr;</button>
      </div>
    </div>
  </div>

  <!-- WHAT MIMATIS OFFERS -->
  <div class="home-offers-section">
    <div class="home-offers-inner">
      <div class="home-offers-left">
        <span class="home-offers-eye">What MIMATIS provides</span>
        <h2 class="home-offers-title">Everything in one place &mdash;<br><em>immediately</em></h2>
        <p class="home-offers-sub">MIMATIS brings together verified support resources, peer-reviewed research, compassionate guidance, and a permanent memorial garden &mdash; all in one digital experience, available at any hour.</p>
        <button class="home-offers-link" onclick="showPage('help')">Find support in your country &rarr;</button>
      </div>
      <div class="home-offers-grid">
        <div class="home-offer-card"><span class="hoc-num">01</span><span class="hoc-title">Verified support resources</span><span class="hoc-body">Helplines, charities, hospital bereavement teams, and funeral support &mdash; verified and curated.</span></div>
        <div class="home-offer-card"><span class="hoc-num">02</span><span class="hoc-title">Research library</span><span class="hoc-body">23 peer-reviewed studies with open-access links &mdash; translated into human language.</span></div>
        <div class="home-offer-card"><span class="hoc-num">03</span><span class="hoc-title">Compassionate guidance</span><span class="hoc-body">From the first hours after loss to the years that follow &mdash; practical, honest, warm.</span></div>
        <div class="home-offer-card"><span class="hoc-num">04</span><span class="hoc-title">Letter templates</span><span class="hoc-body">Nine ready-to-use templates for when words feel impossible to find.</span></div>
        <div class="home-offer-card"><span class="hoc-num">05</span><span class="hoc-title">Memorial garden</span><span class="hoc-body">Plant a flower in your baby&rsquo;s name. It stays here, always.</span></div>
        <div class="home-offer-card"><span class="hoc-num">06</span><span class="hoc-title">For partners &amp; families</span><span class="hoc-body">Guidance for fathers, partners, grandparents, and siblings &mdash; the often invisible grievers.</span></div>
      </div>
    </div>
  </div>

  <!-- FIND HELP BUTTON — replaces country selector -->
  <div class="home-findhelp">
    <div class="home-findhelp-inner">
      <div class="home-findhelp-left">
        <span class="hfh-eye">Support in your country</span>
        <h2 class="hfh-title">Find verified bereavement support<br>wherever you are</h2>
        <p class="hfh-sub">Helplines, charities, hospital bereavement teams, and funeral support &mdash; listed and verified across 29 countries in Europe, the US, and Australia.</p>
      </div>
      <div class="home-findhelp-right">
        <button class="hfh-btn" onclick="showPage('help')">Find help in your country &rarr;</button>
        <p class="hfh-note">Select your country to see verified local resources</p>
      </div>
    </div>
  </div>

  <!-- STAT CARDS -->
  <div class="stat-cards-section">
    <div class="stat-cards-inner">
      <div class="stat-cards-header">
        <span class="stat-cards-title">What the research shows</span>
        <div class="stat-cards-line"></div>
      </div>
      <div class="stat-group">
        <p class="stat-group-label">Stillbirth</p>
        <div class="stat-cards-grid">
          <div class="stat-card"><div class="stat-icon si-rose"><i class="ti ti-clock" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">Nearly <em>2 million</em> babies are stillborn every year &mdash; one every <em>16 seconds</em></p><p class="stat-card-src">WHO &middot; UNICEF</p></div></div>
          <div class="stat-card"><div class="stat-icon si-rose"><i class="ti ti-heart-broken" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">Over <em>40%</em> of all stillbirths occur during labour &mdash; losses that could be avoided with improved care</p><p class="stat-card-src">WHO</p></div></div>
          <div class="stat-card"><div class="stat-icon si-rose"><i class="ti ti-world" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">Stillbirth rates vary from <em>2.9 per 1,000</em> births in western Europe to <em>22.8</em> in west and central Africa</p><p class="stat-card-src">The Lancet &middot; 2021</p></div></div>
          <div class="stat-card"><div class="stat-icon si-rose"><i class="ti ti-shield-check" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">The majority of stillbirths could have been avoided with high-quality care during pregnancy and birth</p><p class="stat-card-src">WHO &middot; UNICEF</p></div></div>
        </div>
      </div>
      <div class="stat-group">
        <p class="stat-group-label">Miscarriage</p>
        <div class="stat-cards-grid">
          <div class="stat-card"><div class="stat-icon si-blue"><i class="ti ti-calendar-stats" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">An estimated <em>23 million</em> miscarriages occur every year &mdash; <em>44</em> pregnancy losses every minute</p><p class="stat-card-src">The Lancet &middot; 2021</p></div></div>
          <div class="stat-card"><div class="stat-icon si-blue"><i class="ti ti-user-heart" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat"><em>1 in every 4 to 5</em> pregnancies results in miscarriage</p><p class="stat-card-src">ACOG &middot; Texas Children&rsquo;s Hospital</p></div></div>
          <div class="stat-card"><div class="stat-icon si-blue"><i class="ti ti-dna" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">Around <em>50%</em> of first trimester miscarriages are caused by chromosomal abnormalities &mdash; not by anything the mother did</p><p class="stat-card-src">NHS &middot; Newcastle Hospitals</p></div></div>
        </div>
      </div>
      <div class="stat-group" style="margin-bottom:0">
        <p class="stat-group-label">Grief &amp; mental health</p>
        <div class="stat-cards-grid">
          <div class="stat-card"><div class="stat-icon si-sage"><i class="ti ti-brain" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">Between <em>30 and 60%</em> of bereaved parents meet the clinical criteria for PTSD following pregnancy or infant loss</p><p class="stat-card-src">MDPI &middot; Peer-reviewed scoping review</p></div></div>
          <div class="stat-card"><div class="stat-icon si-sage"><i class="ti ti-mood-sad" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat">Parents who experience stillbirth have a considerably higher risk of depression, anxiety and PTSD &mdash; a difference that can remain <em>years</em> later</p><p class="stat-card-src">BMC Pregnancy &amp; Childbirth &middot; 2021</p></div></div>
          <div class="stat-card"><div class="stat-icon si-sage"><i class="ti ti-alert-circle" aria-hidden="true"></i></div><div class="stat-card-text"><p class="stat-card-stat"><em>4 in 10</em> people report symptoms of PTSD in the three months following a miscarriage or ectopic pregnancy</p><p class="stat-card-src">Imperial College London</p></div></div>
        </div>
      </div>
    </div>
  </div>

